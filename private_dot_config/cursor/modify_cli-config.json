#!/bin/sh
# Cursor reads this target (local state lives here).
# Approval mode and permissions source of truth: dot_cursor/cli-config.json
set -eu

src="${CHEZMOI_SOURCE_DIR:-$(chezmoi source-path)}/dot_cursor/cli-config.json"
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
cat >"$tmp"

if [ -s "$tmp" ]; then
	jq --slurpfile src "$src" '.approvalMode = $src[0].approvalMode | .permissions = $src[0].permissions' "$tmp"
else
	jq '{approvalMode, permissions}' "$src"
fi
