{
  "repositories": {
    "{{ .gh_work_org }}/{{ .work_project }}": { "account": "{{ .gh_work_user }}" }
  },
  "reviewBots": ["coderabbit"],
  "ignore": [
    { "author": "coderabbitai[bot]", "kind": "issue_comment" },
    { "author": "github-actions[bot]", "kind": "issue_comment" },
    { "author": "github-actions[bot]", "kind": "review" },
    { "author": "github-actions[bot]", "kind": "inline", "bodyIncludes": "[phase-timing]" },
    { "author": "github-actions[bot]", "kind": "inline", "bodyIncludes": "[wait-audit]" },
    { "author": "blacksmith-sh[bot]" }
  ],
  "instructions": "$task-worker\ntask-workerの「PRへの指摘対応」に従って報告してください。"
}
