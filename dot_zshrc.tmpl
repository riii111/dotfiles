# ==========================================
# ghq + git worktree
# ==========================================
export GHQ_ROOT="$HOME/ghq"

# ghq × fzf: jump to repository (Ctrl-G)
cghq() {
  local repo
  repo="$(ghq list | fzf --preview 'eza --tree --level=3 --icons --color=always $(ghq root)/{}')" || return
  cd "$(ghq root)/$repo"
}
if [[ -o zle ]]; then
  _cghq_widget() {
    cghq
    zle reset-prompt
  }
  zle -N _cghq_widget
  bindkey '^G' _cghq_widget
fi

# git switch branch with fzf (Ctrl-B)
git-switch-fzf() {
  git swf
}
# Overrides backward-char; kept for reachability because Ctrl-B is not used for cursor movement here.
if [[ -o zle ]]; then
  _git_switch_fzf_widget() {
    git-switch-fzf
    zle reset-prompt
  }
  zle -N _git_switch_fzf_widget
  bindkey '^B' _git_switch_fzf_widget
fi

# ==========================================
# PostgreSQL service file
# ==========================================
pgservice() {
  local service_file="${PGSERVICEFILE:-$HOME/.pg_service.conf}"

  case "${1:-}" in
    list)
      [[ -r "$service_file" ]] || {
        printf 'pgservice: service file not found: %s\n' "$service_file" >&2
        return 1
      }

      # Only print service names; connection parameters can expose internal hosts or users
      awk '
        /^[[:space:]]*\[[^]]+\][[:space:]]*$/ {
          line = $0
          sub(/^[[:space:]]*\[/, "", line)
          sub(/\][[:space:]]*$/, "", line)
          print line
        }
      ' "$service_file"
      ;;
    path)
      printf '%s\n' "$service_file"
      ;;
    edit)
      command "${EDITOR:-vi}" "$service_file"
      ;;
    *)
      printf 'usage: pgservice {list|path|edit}\n' >&2
      return 2
      ;;
  esac
}

_pgservice() {
  local -a commands
  commands=(
    'list:print service names'
    'path:print service file path'
    'edit:open service file'
  )
  _describe -t commands 'pgservice command' commands
}
[[ -o zle ]] && compdef _pgservice pgservice

