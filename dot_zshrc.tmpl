# ==========================================
# Completion
# ==========================================
if [[ -o zle ]]; then
  if [[ -d "${NIX_DOTFILES_SHARE}/zsh/site-functions" ]]; then
    FPATH="${NIX_DOTFILES_SHARE}/zsh/site-functions:$FPATH"
  fi
  # Homebrew completions
  FPATH="/opt/homebrew/share/zsh/site-functions:$FPATH"
  fpath+=~/.zfunc
  autoload -Uz compinit

  # Use compinit -C unless fpath membership, dir contents, or user files changed
  local _fpath_cache="$HOME/.zcompdump.fpath"
  local _fpath_sig="${(pj:\n:)fpath}"
  local _compinit_flags=(-C)
  if [[ ! -f ~/.zcompdump ]] || [[ ! -f "$_fpath_cache" ]] || [[ "$(<$_fpath_cache)" != "$_fpath_sig" ]]; then
    _compinit_flags=()
  else
    for _fp in $fpath; do
      if [[ "$_fp" -nt ~/.zcompdump ]]; then
        _compinit_flags=(); break
      fi
    done
    if (( $#_compinit_flags )) && [[ -d ~/.zfunc ]]; then
      for _f in ~/.zfunc/*(N); do
        if [[ "$_f" -nt ~/.zcompdump ]]; then
          _compinit_flags=(); break
        fi
      done
    fi
  fi
  compinit $_compinit_flags[@]
  printf '%s\n' $fpath > "$_fpath_cache"
  [[ -s "$HOME/.bun/_bun" ]] && source "$HOME/.bun/_bun"

  # Completion styles
  zstyle ':completion:*' menu select
  zstyle ':completion:*' verbose yes
  zstyle ':completion:*:descriptions' format '%F{yellow}%d%f'
  zstyle ':completion:*' matcher-list 'm:{[:lower:][:upper:]}={[:upper:][:lower:]}'

  # zsh-autosuggestions
  ZSH_AUTOSUGGEST_MANUAL_REBIND=1
  if [[ -f "${NIX_DOTFILES_SHARE}/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
    source "${NIX_DOTFILES_SHARE}/zsh-autosuggestions/zsh-autosuggestions.zsh"
  fi
  ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#888888'
  unset ZSH_AUTOSUGGEST_USE_ASYNC
fi

# ==========================================
# zsh-abbr (deferred: loads on first text input)
# ==========================================
export LG_CONFIG_FILE="$HOME/.config/lazygit/config.yml"

_deferred_abbr_init() {
  unfunction _deferred_abbr_init
  local zsh_abbr_script="${NIX_DOTFILES_SHARE}/zsh/zsh-abbr/zsh-abbr.zsh"
  [[ -f "$zsh_abbr_script" ]] || return

  source "$zsh_abbr_script"

  # Keep these as session abbreviations, ahead of any user definitions. zsh-abbr
  # stores quoted keys and values in its session map; batch setup avoids calling
  # its command parser once for each definition on the first keystroke.
  local -A defaults=(
    cat 'bat' ls 'eza' ll 'eza -hl' la 'eza -hla' lt 'eza --tree' llg 'eza -hlFg'
    vim 'nvim' v 'nvim' nv 'nvim' clr 'clear' o 'open' lg 'lazygit'
    mkdir 'mkdir -p' mkd 'mkdir -p'
    dc 'docker compose' dcb 'docker compose build' dcbn 'docker compose build --no-cache'
    dcu 'docker compose up -d' dcub 'docker compose up --build -d' dcd 'docker compose down -v'
    dcr 'docker compose restart' dps 'docker ps' dpa 'docker ps -a'
    cpf 'pbcopy <' paf 'pbpaste >'
  )
  local -A forced=(cat 1 ls 1 vim 1 o 1 mkdir 1 dc 1)
  local name key
  (( ABBR_DRY_RUN )) && return
  for name in ${(k)defaults}; do
    key=${(qqq)name}
    if (( ! ${+forced[$name]} && ! ABBR_FORCE )); then
      (( ${+ABBR_REGULAR_SESSION_ABBREVIATIONS[$key]} )) && continue
      (( ${+commands[$name]} && ! ${+aliases[$name]} )) && continue
    fi
    ABBR_REGULAR_SESSION_ABBREVIATIONS[$key]=${(qqq)defaults[$name]}
  done
}

typeset -gi _ABBR_INITIALIZED=${_ABBR_INITIALIZED:-0}

_abbr_arm_first_input() {
  (( _ABBR_INITIALIZED )) && return
  zle -A self-insert _abbr_original_self_insert
  zle -N self-insert _abbr_on_first_input
}

_abbr_on_first_input() {
  local keys="$KEYS"

  # Restore original self-insert; fall back to builtin if missing
  if (( ${+widgets[_abbr_original_self_insert]} )); then
    zle -A _abbr_original_self_insert self-insert
  else
    zle -A .self-insert self-insert
  fi

  add-zsh-hook -d precmd _abbr_arm_first_input 2>/dev/null
  _ABBR_INITIALIZED=1

  # Guard: skip if already loaded (e.g. re-source)
  (( ${+functions[_deferred_abbr_init]} )) && _deferred_abbr_init
  (( ${+functions[_zsh_autosuggest_bind_widgets]} )) && _zsh_autosuggest_bind_widgets

  zle -U "$keys"
}

if [[ -o zle ]]; then
  add-zsh-hook precmd _abbr_arm_first_input
fi

