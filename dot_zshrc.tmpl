export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_STATE_HOME="$HOME/.local/state"
# Keep in sync with NIX_DOTFILES_PROFILE in the dotctl CLI implementation.
export NIX_DOTFILES_PROFILE="${NIX_DOTFILES_PROFILE:-$HOME/.nix-profile}"
export NIX_DOTFILES_BIN="${NIX_DOTFILES_PROFILE}/bin"
export NIX_DOTFILES_SHARE="${NIX_DOTFILES_PROFILE}/share"

# Disable XON/XOFF flow control so Ctrl+Q/Ctrl+S are available for keybindings
stty -ixon

# ==========================================
# Shell Options
# ==========================================
