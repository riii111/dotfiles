{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": false,
  "doublePressToConfirm": true,
  "permission": {
    "*": "ask",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.aws/*": "deny",
      "~/.config/gcloud/*": "deny",
      "~/.kube/*": "deny",
      "~/.pi/agent/auth.json": "deny"
    },
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "write": "allow",
    "edit": "allow",
    "lsp_diagnostics": "allow",
    "lsp_fix": "allow",
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls": "allow",
      "ls *": "allow",
      "eza *": "allow",
      "fd *": "allow",
      "rg *": "allow",
      "sed -n *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "jq *": "allow",
      "yq *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git rev-parse*": "allow",
      "git branch --show-current": "allow",
      "git grep*": "allow",
      "git ls-files*": "allow",
      "gh-loupe *": "allow",
      "gh pr view *": "allow",
      "gh pr list *": "allow",
      "gh pr checks *": "allow",
      "gh pr diff *": "allow",
      "gh pr status *": "allow",
      "gh issue view *": "allow",
      "gh issue list *": "allow",
      "gh issue status *": "allow",
      "gh repo view *": "allow",
      "gh run list *": "allow",
      "gh run view *": "allow",
      "gh run watch *": "allow",
      "gh workflow list *": "allow",
      "gh workflow view *": "allow",
      "gh release list *": "allow",
      "gh release view *": "allow",
      "gh search *": "allow",
      "gcloud storage ls *": "allow",
      "gcloud run jobs list *": "allow",
      "gcloud run jobs describe *": "allow",
      "gcloud run jobs executions list *": "allow",
      "gcloud run jobs executions describe *": "allow",
      "gcloud run services list *": "allow",
      "gcloud run services describe *": "allow",
      "gcloud run revisions list *": "allow",
      "gcloud run revisions describe *": "allow",
      "gcloud logging read *": "allow",
      "gcloud auth list *": "allow",
      "gcloud config list *": "allow",
      "gcloud config configurations list *": "allow",
      "bq ls *": "allow",
      "bq show *": "allow",
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "rm --recursive --force *": "deny",
      "sudo *": "deny",
      "doas *": "deny",
      "su *": "deny",
      "git push --force*": "deny",
      "git push -f *": "deny",
      "git push --mirror*": "deny",
      "git push --delete*": "deny",
      "git push -d *": "deny",
      "git push --prune*": "deny",
      "git clean -fdx*": "deny",
      "git add -f *": "deny",
      "git add --force*": "deny",
      "git reset --hard*": "deny",
      "git reset HEAD --hard*": "deny",
      "git restore .": "deny",
      "git restore :/": "deny",
      "git checkout -- .": "deny",
      "git checkout -- :/": "deny",
      "git stash clear*": "deny",
      "git stash drop*": "deny",
      "gh auth token*": "deny",
      "gh repo delete*": "deny",
      "gh auth login*": "deny",
      "gh auth refresh*": "deny",
      "gh auth setup-git*": "deny",
      "gcloud auth print-access-token*": "deny",
      "gcloud projects delete*": "deny",
      "gcloud storage rm *": "deny",
      "gcloud run jobs delete*": "deny",
      "gcloud run services delete*": "deny",
      "gcloud iam service-accounts keys create*": "deny",
      "terraform apply*": "deny",
      "terraform destroy*": "deny",
      "terraform state rm *": "deny",
      "terraform state mv *": "deny",
      "terraform taint*": "deny",
      "terraform import*": "deny",
      "terraform force-unlock*": "deny",
      "terraform workspace delete*": "deny",
      "find * -delete*": "deny",
      "chezmoi purge*": "deny",
      "chezmoi destroy*": "deny",
      "bq rm *": "deny",
      "chmod 777 *": "deny"
    },
    "external_directory": "ask"
  }
}
