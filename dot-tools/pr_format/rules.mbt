// The mechanical format rules for a pull request's title and body.
// Rules that need judgment, such as a restated title, belong to the prompt hook in settings.json instead.

///|
let max_bullets : Int32 = 3

///|
/// Problems with a pull request body.
pub fn check_body(body : String) -> Array[String] {
  let lines = prose_lines(body)
  let problems = []
  if has_attribution(body) {
    problems.push(
      "Claude Codeの署名とセッションのリンクを書かない。`Generated by Claude Code` の行と区切り線を消す",
    )
  }
  let top_level = lines.iter().filter(is_top_level_bullet).count()
  if lines.iter().any(line => refs_line(@text.strip(line))) {
    problems.push(
      "対象Issueは `Close #N` で参照する。1 Issue = 1 PRに分け、Refsにしたくなる場合はPRかIssueを分ける。対象Issueがなければ参照は不要",
    )
  }
  if top_level > max_bullets {
    problems.push(
      "箇条書きが\{top_level}個ある。\{max_bullets}個以内に統合する",
    )
  }
  if lines
    .iter()
    .any(line => is_bullet(line) && line.trim_end().has_suffix("。")) {
    problems.push("箇条書きの文末に句点を付けない")
  }
  if lines.iter().any(is_checklist) {
    problems.push("確認チェックリストを書かない")
  }
  if lines.iter().any(line => line.contains_any(chars="（）()")) {
    problems.push(
      "カッコによる補足を使わない。補足は別の文にする",
    )
  }
  if lines
    .iter()
    .any(line => has_reference(line) && !is_reference_line(@text.strip(line))) {
    problems.push(
      "IssueやPRの番号を文中に埋め込まない。Issueは先頭の `Close #N` の行に書き、PRの番号は書かない",
    )
  }
  if lines.iter().any(has_mixed_space) {
    problems.push(
      "本文の日本語と英語の間にスペースを入れない",
    )
  }
  problems.push_iter(check_sentences(lines).iter())
  problems
}

///|
/// Returns the index after a list marker, `[-*+]` or `\d+[.)]`, at `index`.
fn list_marker_end(chars : Array[Char], index : Int32) -> Int32? {
  match chars.get(index) {
    Some('-' | '*' | '+') => Some(index + 1)
    Some(char) if @text.is_decimal(char) => {
      let mut end = index
      while end < chars.length() && @text.is_decimal(chars[end]) {
        end += 1
      }
      match chars.get(end) {
        Some('.' | ')') => Some(end + 1)
        _ => None
      }
    }
    _ => None
  }
}

///|
/// A marker followed by a space and no `[ ]`, `[x]` or `[X]`.
fn is_bullet_from(chars : Array[Char], index : Int32) -> Bool {
  guard list_marker_end(chars, index) is Some(end) &&
    chars.get(end) is Some(' ') else {
    return false
  }
  !is_checkbox(chars, end + 1)
}

///|
fn is_checkbox(chars : Array[Char], index : Int32) -> Bool {
  chars.get(index) is Some('[') &&
  chars.get(index + 1) is Some(' ' | 'x' | 'X') &&
  chars.get(index + 2) is Some(']')
}

///|
fn indent(chars : Array[Char]) -> Int32 {
  let mut index = 0
  while index < chars.length() && @shell.is_python_whitespace(chars[index]) {
    index += 1
  }
  index
}

///|
/// Mirrors `^\s*(?:[-*+]|\d+[.)]) (?!\[[ xX]\])`.
fn is_bullet(line : String) -> Bool {
  let chars = line.iter().collect()
  is_bullet_from(chars, indent(chars))
}

///|
/// Mirrors `^ {0,3}(?:[-*+]|\d+[.)]) (?!\[[ xX]\])`.
fn is_top_level_bullet(line : String) -> Bool {
  let chars = line.iter().collect()
  let mut spaces = 0
  while spaces < chars.length() && chars[spaces] == ' ' {
    spaces += 1
  }
  spaces <= 3 && is_bullet_from(chars, spaces)
}

///|
/// Mirrors `^\s*[-*+] \[[ xX]\]`.
fn is_checklist(line : String) -> Bool {
  let chars = line.iter().collect()
  let index = indent(chars)
  chars.get(index) is Some('-' | '*' | '+') &&
  chars.get(index + 1) is Some(' ') &&
  is_checkbox(chars, index + 2)
}

///|
fn has_attribution(body : String) -> Bool {
  let lower = body.to_lower()
  lower.contains("generated by claude code") ||
  lower.contains("generated by [claude code") ||
  lower.contains("generated with claude code") ||
  lower.contains("generated with [claude code") ||
  lower.contains("claude.ai/code/session_")
}
