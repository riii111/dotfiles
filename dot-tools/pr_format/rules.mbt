// The mechanical format rules for a pull request's title and body.
// Rules that need judgment, such as a restated title, belong to the prompt hook in settings.json instead.

///|
let title_types : Array[String] = [
  "feat", "fix", "docs", "style", "refactor", "perf", "test", "build", "ci", "chore",
  "revert",
]

///|
let max_bullets : Int32 = 3

///|
/// Problems with a pull request title.
pub fn check_title(title : String) -> Array[String] {
  let problems = []
  if !is_conventional_title(title) {
    problems.push(
      "タイトルはConventional Commitsのtypeで始め、`type: 概要` の形にする",
    )
  }
  if has_mixed_space(title) {
    problems.push(
      "タイトルの日本語と英語の間にスペースを入れない",
    )
  }
  problems
}

///|
/// Mirrors `^(type)(\([^)\s]+\))?!?: \S`.
fn is_conventional_title(title : String) -> Bool {
  guard title_types.iter().find_first(kind => title.has_prefix(kind))
    is Some(kind) else {
    return false
  }
  let rest = title.view(start_offset=kind.length()).to_owned()
  let after_scope = match scope_end(rest) {
    Some(end) if colon_follows(rest.view(start_offset=end).to_owned()) => end
    _ => 0
  }
  colon_follows(rest.view(start_offset=after_scope).to_owned())
}

///|
fn scope_end(text : String) -> Int32? {
  guard text.has_prefix("(") else { return None }
  let mut index = 1
  while text.get_char(index) is Some(char) {
    if char == ')' {
      return if index > 1 { Some(index + 1) } else { None }
    }
    if @shell.is_python_whitespace(char) {
      return None
    }
    index += char.utf16_len()
  }
  None
}

///|
fn colon_follows(text : String) -> Bool {
  let text = text.strip_prefix("!").map(view => view.to_owned()).unwrap_or(text)
  guard text.strip_prefix(": ") is Some(rest) else { return false }
  rest.get_char(0) is Some(char) && !@shell.is_python_whitespace(char)
}

///|
/// Problems with a pull request body.
pub fn check_body(body : String) -> Array[String] {
  let lines = prose_lines(body)
  let problems = []
  if has_attribution(body) {
    problems.push(
      "Claude Codeの署名とセッションのリンクを書かない。`Generated by Claude Code` の行と区切り線を消す",
    )
  }
  let top_level = lines.iter().filter(is_top_level_bullet).count()
  if lines.iter().any(line => refs_line(@text.strip(line))) {
    problems.push(
      "対象Issueは `Close #N` で参照する。1 Issue = 1 PRに分け、Refsにしたくなる場合はPRかIssueを分ける。対象Issueがなければ参照は不要",
    )
  }
  if top_level > max_bullets {
    problems.push(
      "箇条書きが\{top_level}個ある。\{max_bullets}個以内に統合する",
    )
  }
  if lines
    .iter()
    .any(line => is_bullet(line) && line.trim_end().has_suffix("。")) {
    problems.push("箇条書きの文末に句点を付けない")
  }
  if lines.iter().any(is_checklist) {
    problems.push("確認チェックリストを書かない")
  }
  if lines.iter().any(line => line.contains_any(chars="（）()")) {
    problems.push(
      "カッコによる補足を使わない。補足は別の文にする",
    )
  }
  if lines
    .iter()
    .any(line => has_reference(line) && !is_reference_line(@text.strip(line))) {
    problems.push(
      "IssueやPRの番号を文中に埋め込まない。Issueは先頭の `Close #N` の行に書き、PRの番号は書かない",
    )
  }
  if lines.iter().any(has_mixed_space) {
    problems.push(
      "本文の日本語と英語の間にスペースを入れない",
    )
  }
  problems.push_iter(check_sentences(lines).iter())
  problems
}

///|
/// Problems when the title or the prose of the body is not in `language`, which is `ja` or `en`.
pub fn check_language(
  language : String,
  title : String?,
  body : String?,
) -> Array[String] {
  let prose = prose_lines(body.unwrap_or(""))
    .iter()
    .filter(line => {
      let stripped = @text.strip(line)
      stripped != "" && !is_reference_line(stripped)
    })
    .collect()
  let mismatched = if language == "ja" {
    (title is Some(title) && !has_japanese(title)) ||
    (!prose.is_empty() && !prose.iter().any(has_japanese))
  } else {
    [title.unwrap_or(""), ..prose].iter().any(has_japanese)
  }
  if mismatched {
    let name = if language == "ja" { "日本語" } else { "英語" }
    ["このリポジトリのPRは\{name}で書く"]
  } else {
    []
  }
}

///|
/// The lines outside code fences, without inline code and link targets.
fn prose_lines(body : String) -> Array[String] {
  let lines = []
  let mut in_fence = false
  for line in @text.split_lines(body) {
    if skip_indent(line).has_prefix("```") {
      in_fence = !in_fence
    } else if !in_fence {
      lines.push(remove_link_targets(remove_code_spans(line)))
    }
  }
  lines
}

///|
fn skip_indent(line : String) -> String {
  match line.find_by(char => !@shell.is_python_whitespace(char)) {
    Some(index) => line.view(start_offset=index).to_owned()
    None => ""
  }
}

///|
/// Removes `` `[^`\n]*` `` spans.
fn remove_code_spans(line : String) -> String {
  let result = StringBuilder()
  let mut index = 0
  while index < line.length() {
    if line.code_unit_at(index) == '`' &&
      line.view(start_offset=index + 1).find("`") is Some(offset) {
      index += offset + 2
      continue
    }
    result.write_char(line.get_char(index).unwrap())
    index += line.get_char(index).unwrap().utf16_len()
  }
  result.to_string()
}

///|
/// Replaces `\]\([^)\s]*\)` with `]`.
fn remove_link_targets(line : String) -> String {
  let result = StringBuilder()
  let mut index = 0
  while index < line.length() {
    let char = line.get_char(index).unwrap()
    if char == ']' && link_target_end(line, index + 1) is Some(end) {
      result.write_char(']')
      index = end
      continue
    }
    result.write_char(char)
    index += char.utf16_len()
  }
  result.to_string()
}

///|
fn link_target_end(line : String, start : Int32) -> Int32? {
  guard line.view(start_offset=start).has_prefix("(") else { return None }
  let mut index = start + 1
  while line.get_char(index) is Some(char) {
    if char == ')' {
      return Some(index + 1)
    }
    if @shell.is_python_whitespace(char) {
      return None
    }
    index += char.utf16_len()
  }
  None
}

///|
fn is_japanese(char : Char) -> Bool {
  let code = char.to_int()
  (code >= 0x3040 && code <= 0x30FF) || (code >= 0x3400 && code <= 0x9FFF)
}

///|
fn has_japanese(text : String) -> Bool {
  text.iter().any(is_japanese)
}

///|
fn is_ascii_word(char : Char) -> Bool {
  char.is_ascii_alphabetic() || char.is_ascii_digit()
}

///|
/// Mirrors `JA[ \t]+ASCII|ASCII[ \t]+JA`.
fn has_mixed_space(text : String) -> Bool {
  let chars = text.iter().collect()
  let mut index = 0
  while index < chars.length() {
    guard chars[index] == ' ' || chars[index] == '\t' else {
      index += 1
      continue
    }
    let start = index
    while index < chars.length() &&
          (chars[index] == ' ' || chars[index] == '\t') {
      index += 1
    }
    if start > 0 && index < chars.length() {
      let before = chars[start - 1]
      let after = chars[index]
      if (is_japanese(before) && is_ascii_word(after)) ||
        (is_ascii_word(before) && is_japanese(after)) {
        return true
      }
    }
  }
  false
}

///|
/// Returns the index after a list marker, `[-*+]` or `\d+[.)]`, at `index`.
fn list_marker_end(chars : Array[Char], index : Int32) -> Int32? {
  match chars.get(index) {
    Some('-' | '*' | '+') => Some(index + 1)
    Some(char) if @text.is_decimal(char) => {
      let mut end = index
      while end < chars.length() && @text.is_decimal(chars[end]) {
        end += 1
      }
      match chars.get(end) {
        Some('.' | ')') => Some(end + 1)
        _ => None
      }
    }
    _ => None
  }
}

///|
/// A marker followed by a space and no `[ ]`, `[x]` or `[X]`.
fn is_bullet_from(chars : Array[Char], index : Int32) -> Bool {
  guard list_marker_end(chars, index) is Some(end) &&
    chars.get(end) is Some(' ') else {
    return false
  }
  !is_checkbox(chars, end + 1)
}

///|
fn is_checkbox(chars : Array[Char], index : Int32) -> Bool {
  chars.get(index) is Some('[') &&
  chars.get(index + 1) is Some(' ' | 'x' | 'X') &&
  chars.get(index + 2) is Some(']')
}

///|
fn indent(chars : Array[Char]) -> Int32 {
  let mut index = 0
  while index < chars.length() && @shell.is_python_whitespace(chars[index]) {
    index += 1
  }
  index
}

///|
/// Mirrors `^\s*(?:[-*+]|\d+[.)]) (?!\[[ xX]\])`.
fn is_bullet(line : String) -> Bool {
  let chars = line.iter().collect()
  is_bullet_from(chars, indent(chars))
}

///|
/// Mirrors `^ {0,3}(?:[-*+]|\d+[.)]) (?!\[[ xX]\])`.
fn is_top_level_bullet(line : String) -> Bool {
  let chars = line.iter().collect()
  let mut spaces = 0
  while spaces < chars.length() && chars[spaces] == ' ' {
    spaces += 1
  }
  spaces <= 3 && is_bullet_from(chars, spaces)
}

///|
/// Mirrors `^\s*[-*+] \[[ xX]\]`.
fn is_checklist(line : String) -> Bool {
  let chars = line.iter().collect()
  let index = indent(chars)
  chars.get(index) is Some('-' | '*' | '+') &&
  chars.get(index + 1) is Some(' ') &&
  is_checkbox(chars, index + 2)
}

///|
let closing_keywords : Array[String] = [
  "closes", "closed", "close", "fixes", "fixed", "fix", "resolves", "resolved", "resolve",
  "refs", "ref",
]

///|
/// Mirrors `^(?:(?:close[sd]?|fix(?:e[sd])?|resolve[sd]?|refs?)\s+.*#\d+|→\s)` with `re.IGNORECASE`.
fn is_reference_line(line : String) -> Bool {
  if line.has_prefix("→") {
    return line.get_char(1) is Some(char) && @shell.is_python_whitespace(char)
  }
  keyword_reference(line, closing_keywords)
}

///|
/// Mirrors `^refs?\s+.*#\d+` with `re.IGNORECASE`.
fn refs_line(line : String) -> Bool {
  keyword_reference(line, ["refs", "ref"])
}

///|
fn keyword_reference(line : String, keywords : Array[String]) -> Bool {
  let lower = line.to_lower()
  keywords
  .iter()
  .any(keyword => {
    lower.has_prefix(keyword) &&
    line.get_char(keyword.length()) is Some(char) &&
    @shell.is_python_whitespace(char) &&
    has_issue_number(line.view(start_offset=keyword.length() + 1).to_owned())
  })
}

///|
fn has_issue_number(text : String) -> Bool {
  let chars = text.iter().collect()
  for index, char in chars {
    if char == '#' &&
      chars.get(index + 1) is Some(next) &&
      @text.is_decimal(next) {
      return true
    }
  }
  false
}

///|
/// Mirrors `(?<![A-Za-z0-9&])(?:[\w.-]+/[\w.-]+)?#\d+\b|https://github\.com/[^/\s]+/[^/\s]+/(?:issues|pull)/\d+`.
fn has_reference(line : String) -> Bool {
  let chars = line.iter().collect()
  for index, char in chars {
    if char == '#' &&
      issue_number_end(chars, index + 1) &&
      reference_start(chars, index) {
      return true
    }
  }
  has_github_link(line)
}

///|
/// `\d+\b` after `#`.
fn issue_number_end(chars : Array[Char], start : Int32) -> Bool {
  let mut end = start
  while end < chars.length() && @text.is_decimal(chars[end]) {
    end += 1
  }
  end > start && !(chars.get(end) is Some(next) && @text.is_word_char(next))
}

///|
fn is_reference_neighbor(char : Char) -> Bool {
  char.is_ascii_alphabetic() || char.is_ascii_digit() || char == '&'
}

///|
fn is_name_char(char : Char) -> Bool {
  @text.is_word_char(char) || char == '.' || char == '-'
}

///|
/// Whether a reference can start before the `#` at `hash`: right there, or at an `owner/repo` prefix.
fn reference_start(chars : Array[Char], hash : Int32) -> Bool {
  if hash == 0 || !is_reference_neighbor(chars[hash - 1]) {
    return true
  }
  let mut slash = hash
  while slash > 0 && is_name_char(chars[slash - 1]) {
    slash -= 1
  }
  guard slash < hash && slash > 0 && chars[slash - 1] == '/' else {
    return false
  }
  let slash = slash - 1
  let mut start = slash
  while start > 0 && is_name_char(chars[start - 1]) {
    start -= 1
  }
  for owner_start in start..<slash {
    if owner_start == 0 || !is_reference_neighbor(chars[owner_start - 1]) {
      return true
    }
  }
  false
}

///|
fn has_github_link(line : String) -> Bool {
  let mut from = 0
  while line.view(start_offset=from).find("https://github.com/") is Some(offset) {
    let start = from + offset + "https://github.com/".length()
    from = start
    let rest = line.view(start_offset=start).to_owned()
    let parts = rest.split("/").map(part => part.to_owned()).collect()
    guard parts is [owner, repo, kind, number, ..] else { continue }
    if is_path_part(owner) &&
      is_path_part(repo) &&
      (kind == "issues" || kind == "pull") &&
      number.get_char(0) is Some(digit) &&
      @text.is_decimal(digit) {
      return true
    }
  }
  false
}

///|
fn is_path_part(text : String) -> Bool {
  text != "" && !text.iter().any(@shell.is_python_whitespace)
}

///|
fn has_attribution(body : String) -> Bool {
  let lower = body.to_lower()
  lower.contains("generated by claude code") ||
  lower.contains("generated by [claude code") ||
  lower.contains("generated with claude code") ||
  lower.contains("generated with [claude code") ||
  lower.contains("claude.ai/code/session_")
}

///|
let sentence_closers : String = "」』）) "

///|
fn check_sentences(lines : Array[String]) -> Array[String] {
  let every = []
  let terminated = []
  for line in lines {
    if is_bullet(line) {
      continue
    }
    let parts = line.split("。").map(part => part.to_owned()).collect()
    for index, part in parts {
      if has_japanese(part) {
        every.push(part)
        if index < parts.length() - 1 {
          terminated.push(part)
        }
      }
    }
  }
  let problems = []
  if terminated.iter().any(ends_with_noun) {
    problems.push(
      "文末を述語で終える。名詞や数字で終わる文がある",
    )
  }
  if every
    .iter()
    .any(sentence => {
      has_reason_clause(sentence) && has_condition_clause(sentence)
    }) {
    problems.push("1文に理由と条件を重ねない。文を分ける")
  }
  problems
}

///|
/// Mirrors `[㐀-鿿゠-ヿA-Za-z0-9]$` after the closing brackets are removed.
fn ends_with_noun(sentence : String) -> Bool {
  let trimmed = sentence.trim_end(chars=sentence_closers)
  guard trimmed.iter().collect().last() is Some(char) else { return false }
  let code = char.to_int()
  (code >= 0x3400 && code <= 0x9FFF) ||
  (code >= 0x30A0 && code <= 0x30FF) ||
  is_ascii_word(char)
}

///|
fn has_reason_clause(sentence : String) -> Bool {
  ["ので、", "ため、", "から、"]
  .iter()
  .any(clause => sentence.contains(clause))
}

///|
fn has_condition_clause(sentence : String) -> Bool {
  ["れば、", "たら、", "なら、", "場合、"]
  .iter()
  .any(clause => sentence.contains(clause))
}
