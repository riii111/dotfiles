{
  "description": "Deterministic approval for narrowly scoped development operations.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "~/.nix-profile/bin/agent-hooks pre-tool-use --codex",
            "timeout": 30,
            "statusMessage": "Checking command policy"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "~/.nix-profile/bin/agent-hooks permission-request",
            "timeout": 5,
            "statusMessage": "Checking command policy"
          }
        ]
      }
    ]
  }
}
