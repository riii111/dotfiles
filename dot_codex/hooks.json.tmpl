{
  "description": "Deterministic approval for narrowly scoped development operations.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash ~/.codex/herdr-agent-state.sh session",
            "timeout": 10,
            "type": "command"
          }{{ if eq .type "personal" }},
          {
            "command": "python3 ~/bin/affected-agent codex-status",
            "timeout": 2,
            "type": "command"
          }{{ end }}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/permission_request.py",
            "timeout": 5,
            "statusMessage": "Checking forbidden commands"
          },
          {
            "type": "command",
            "command": "~/.nix-profile/bin/agent-hooks pr-format-check",
            "timeout": 5,
            "statusMessage": "Checking PR format"
          },
          {
            "type": "command",
            "command": "~/.nix-profile/bin/agent-hooks pr-state-check --deny-merge",
            "timeout": 15,
            "statusMessage": "Checking PR state"
          }
        ]
      },
      {
        "matcher": "^(Bash|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "~/.nix-profile/bin/agent-hooks github-comment-check",
            "timeout": 5,
            "statusMessage": "Checking GitHub comment policy"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/permission_request.py",
            "timeout": 5,
            "statusMessage": "Checking command policy"
          }
        ]
      }
    ]
  }
}
