# =============================================================================
# Codex Execpolicy Rules
# Converted from ~/.claude/settings.json
# Format: Starlark (prefix_rule function)
# Decision priority: forbidden > prompt > allow
# =============================================================================

# -----------------------------------------------------------------------------
# ALLOW: Safe read-only and build commands
# -----------------------------------------------------------------------------

# --- Rust ---
prefix_rule(pattern=["cargo", "build"], decision="allow", justification="Rust build")
prefix_rule(pattern=["cargo", "check"], decision="allow", justification="Rust type check")
prefix_rule(pattern=["cargo", "clippy"], decision="allow", justification="Rust linter")
prefix_rule(pattern=["cargo", "fmt"], decision="allow", justification="Rust formatter")
prefix_rule(pattern=["cargo", "audit"], decision="allow", justification="Rust security audit")
prefix_rule(pattern=["cargo", "test"], decision="allow", justification="Rust tests")
prefix_rule(pattern=["cargo", "run"], decision="allow", justification="Run Rust binary")
prefix_rule(
    pattern=["cargo", "metadata", "--no-deps"],
    decision="allow",
    justification="Read workspace metadata without resolving dependencies",
    match=["cargo metadata --no-deps", "cargo metadata --no-deps --format-version 1"],
    not_match=["cargo metadata", "cargo metadata --format-version 1"],
)

# --- Go ---
prefix_rule(pattern=["go", "build"], decision="allow", justification="Go build")
prefix_rule(pattern=["go", "mod"], decision="allow", justification="Go modules")
prefix_rule(pattern=["go", "vet"], decision="allow", justification="Go vet")
prefix_rule(pattern=["go", "fmt"], decision="allow", justification="Go formatter")
prefix_rule(pattern=["go", "test"], decision="allow", justification="Go tests")
prefix_rule(pattern=["golangci-lint"], decision="allow", justification="Go linter")
prefix_rule(pattern=["goimports"], decision="allow", justification="Go imports formatter")

# --- Node.js ---
prefix_rule(pattern=["npm", "run"], decision="allow", justification="npm scripts")
prefix_rule(pattern=["npm", "test"], decision="allow", justification="npm test")

# --- Terraform ---
prefix_rule(pattern=["terraform", "fmt"], decision="allow", justification="Format Terraform files")
prefix_rule(pattern=["terraform", "validate"], decision="allow", justification="Validate Terraform configuration")
prefix_rule(pattern=["terraform", "show"], decision="allow", justification="Show Terraform state or plan")
prefix_rule(pattern=["terraform", "output"], decision="allow", justification="Show Terraform outputs")
prefix_rule(pattern=["terraform", "state", "list"], decision="allow", justification="List Terraform state resources")

# --- Make ---
prefix_rule(pattern=["make", "test-unit"], decision="allow", justification="Unit tests")
prefix_rule(pattern=["make", "test"], decision="allow", justification="Make test")
prefix_rule(pattern=["make", "build"], decision="allow", justification="Make build")
prefix_rule(pattern=["make", "lint"], decision="allow", justification="Make lint")
prefix_rule(pattern=["make", "fmt"], decision="allow", justification="Make format")

# --- Git (read-only) ---
prefix_rule(pattern=["git", "status"], decision="allow", justification="Show working tree status")
prefix_rule(pattern=["git", "diff"], decision="allow", justification="Show changes")
prefix_rule(pattern=["git", "log"], decision="allow", justification="Show commit history")
prefix_rule(pattern=["git", "show"], decision="allow", justification="Show commit details")
prefix_rule(pattern=["git", "blame"], decision="allow", justification="Show file annotations")
prefix_rule(pattern=["git", "branch", "--show-current"], decision="allow", justification="Show current branch")
prefix_rule(pattern=["git", "branch", "--list"], decision="allow", justification="List branches")
prefix_rule(pattern=["git", "branch", "-l"], decision="allow", justification="List branches")
prefix_rule(pattern=["git", "branch", "--all"], decision="allow", justification="List all branches")
prefix_rule(pattern=["git", "branch", "-a"], decision="allow", justification="List all branches")
prefix_rule(pattern=["git", "branch", "--remotes"], decision="allow", justification="List remote branches")
prefix_rule(pattern=["git", "branch", "-r"], decision="allow", justification="List remote branches")
prefix_rule(pattern=["git", "tag", "--list"], decision="allow", justification="List tags")
prefix_rule(pattern=["git", "tag", "-l"], decision="allow", justification="List tags")
prefix_rule(pattern=["git", "remote", "-v"], decision="allow", justification="List remotes and URLs")
prefix_rule(pattern=["git", "remote", "get-url"], decision="allow", justification="Read remote URL")
prefix_rule(pattern=["git", "remote", "show"], decision="allow", justification="Show remote information")
prefix_rule(pattern=["git", "fetch"], decision="allow", justification="Fetch from remote")
prefix_rule(pattern=["git", "cherry"], decision="allow", justification="Find commits not merged")
prefix_rule(pattern=["git", "merge-tree"], decision="allow", justification="Inspect merge result without mutating history")
prefix_rule(pattern=["git", "merge-base"], decision="allow", justification="Find common Git ancestors")
prefix_rule(pattern=["git", "ls-tree"], decision="allow", justification="List Git tree contents")
prefix_rule(pattern=["git", "for-each-ref"], decision="allow", justification="List Git refs")
prefix_rule(pattern=["git", "cat-file"], decision="allow", justification="Inspect Git objects")
prefix_rule(pattern=["git", "diff-tree"], decision="allow", justification="Compare Git trees")
prefix_rule(pattern=["git", "stash", "list"], decision="allow", justification="List stashes")
prefix_rule(pattern=["git", "stash", "show"], decision="allow", justification="Show stash contents")
prefix_rule(pattern=["git", "config", "--get"], decision="allow", justification="Read git config value")
prefix_rule(pattern=["git", "config", "--list"], decision="allow", justification="List git config values")
prefix_rule(pattern=["git", "config", "--global", "--get"], decision="allow", justification="Read global git config value")
prefix_rule(pattern=["git", "config", "--global", "--list"], decision="allow", justification="List global git config values")
prefix_rule(pattern=["git", "rev-parse"], decision="allow", justification="Parse git refs")
prefix_rule(pattern=["git", "ls-files"], decision="allow", justification="List tracked files")

# --- Git (write operations) ---
prefix_rule(pattern=["git", "add", "-f"], decision="forbidden", justification="Force-add bypasses .gitignore — may commit excluded files")
prefix_rule(pattern=["git", "add", "--force"], decision="forbidden", justification="Force-add bypasses .gitignore — may commit excluded files")
prefix_rule(pattern=["git", "add"], decision="allow", justification="Stage changes")
prefix_rule(pattern=["git", "apply"], decision="allow", justification="Apply a patch to the working tree")
prefix_rule(pattern=["git", "commit"], decision="allow", justification="Commit changes")
prefix_rule(pattern=["git", "cherry-pick"], decision="allow", justification="Apply a specific commit onto the current branch")
prefix_rule(pattern=["git", "switch"], decision="allow", justification="Switch branches")
prefix_rule(pattern=["git", "pull"], decision="allow", justification="Update local branch from remote")

# --- File search/view tools ---
prefix_rule(pattern=["rg"], decision="allow", justification="ripgrep search")
prefix_rule(pattern=["bat"], decision="allow", justification="bat file viewer")
prefix_rule(pattern=["eza"], decision="allow", justification="eza ls replacement")
prefix_rule(pattern=["ls"], decision="allow", justification="List files")
prefix_rule(pattern=["head"], decision="allow", justification="Show file head")
prefix_rule(pattern=["tail"], decision="allow", justification="Show file tail")
prefix_rule(pattern=["cat"], decision="allow", justification="Concatenate files")
prefix_rule(pattern=["wc"], decision="allow", justification="Word count")
prefix_rule(pattern=["tree"], decision="allow", justification="Directory tree")
prefix_rule(pattern=["file"], decision="allow", justification="File type detection")
prefix_rule(pattern=["stat"], decision="allow", justification="File status")
prefix_rule(pattern=["which"], decision="allow", justification="Locate command")
prefix_rule(pattern=["pwd"], decision="allow", justification="Print working directory")

# --- GitHub CLI (read operations) ---
prefix_rule(pattern=["gh", "pr", "view"], decision="allow", justification="View PR")
prefix_rule(pattern=["gh", "pr", "list"], decision="allow", justification="List PRs")
prefix_rule(pattern=["gh", "pr", "checkout"], decision="allow", justification="Checkout PR")
prefix_rule(pattern=["gh", "pr", "checks"], decision="allow", justification="PR checks")
prefix_rule(pattern=["gh", "pr", "diff"], decision="allow", justification="PR diff")
prefix_rule(pattern=["gh", "pr", "status"], decision="allow", justification="PR status")
prefix_rule(pattern=["gh", "issue", "view"], decision="allow", justification="View issue")
prefix_rule(pattern=["gh", "issue", "list"], decision="allow", justification="List issues")
prefix_rule(pattern=["gh", "issue", "status"], decision="allow", justification="Issue status")
prefix_rule(pattern=["gh", "repo", "view"], decision="allow", justification="View repo")
prefix_rule(pattern=["gh", "run", "list"], decision="allow", justification="List workflow runs")
prefix_rule(pattern=["gh", "run", "view"], decision="allow", justification="View workflow run")
prefix_rule(pattern=["gh", "run", "watch"], decision="allow", justification="Watch workflow run")
prefix_rule(pattern=["gh", "workflow", "list"], decision="allow", justification="List workflows")
prefix_rule(pattern=["gh", "workflow", "view"], decision="allow", justification="View workflow")
prefix_rule(pattern=["gh", "release", "list"], decision="allow", justification="List releases")
prefix_rule(pattern=["gh", "release", "view"], decision="allow", justification="View release")
prefix_rule(pattern=["gh", "search"], decision="allow", justification="Search GitHub resources")
prefix_rule(pattern=["gh-pr-comments"], decision="allow", justification="Read PR comments through the fixed read-only wrapper")

# --- gCloud CLI (read operations) ---
prefix_rule(pattern=["gcloud", "storage", "ls"], decision="allow", justification="List GCS buckets or objects")
prefix_rule(pattern=["gcloud", "run", "jobs", "list"], decision="allow", justification="List Cloud Run jobs")
prefix_rule(pattern=["gcloud", "run", "jobs", "describe"], decision="allow", justification="Describe Cloud Run job")
prefix_rule(pattern=["gcloud", "run", "jobs", "executions", "describe"], decision="allow", justification="Describe Cloud Run job execution")
prefix_rule(pattern=["gcloud", "logging", "read"], decision="allow", justification="Read Cloud Logging entries")
prefix_rule(pattern=["gcloud", "auth", "list"], decision="allow", justification="List active gcloud credentials")
prefix_rule(pattern=["gcloud", "config", "list"], decision="allow", justification="List gcloud config values")
prefix_rule(pattern=["gcloud", "config", "configurations", "list"], decision="allow", justification="List gcloud configurations")

# --- Other safe commands ---
prefix_rule(pattern=["pe"], decision="allow", justification="Run prod-errors alert triage")
prefix_rule(pattern=["echo"], decision="allow", justification="Print text")
prefix_rule(pattern=["date"], decision="allow", justification="Show date/time")
prefix_rule(pattern=["printenv"], decision="allow", justification="Print environment")
prefix_rule(pattern=["uname"], decision="allow", justification="System info")
prefix_rule(pattern=["whoami"], decision="allow", justification="Current user")
prefix_rule(pattern=["id"], decision="allow", justification="User/group IDs")
prefix_rule(pattern=["hostname"], decision="allow", justification="System hostname")
prefix_rule(pattern=["df"], decision="allow", justification="Disk usage")
prefix_rule(pattern=["du"], decision="allow", justification="Directory usage")
prefix_rule(pattern=["ps"], decision="allow", justification="Process list")
prefix_rule(pattern=["top", "-l", "1"], decision="allow", justification="One-shot top")
prefix_rule(pattern=["jq"], decision="allow", justification="JSON processor")
prefix_rule(pattern=["yq"], decision="allow", justification="YAML processor")
prefix_rule(pattern=["sort"], decision="allow", justification="Sort lines")
prefix_rule(pattern=["uniq"], decision="allow", justification="Filter duplicates")
prefix_rule(pattern=["grep"], decision="allow", justification="Pattern matching")
prefix_rule(pattern=["cut"], decision="allow", justification="Cut columns")
prefix_rule(pattern=["tr"], decision="allow", justification="Translate chars")
prefix_rule(pattern=["tee"], decision="allow", justification="Pipe to file")
prefix_rule(pattern=["diff"], decision="allow", justification="Compare files")
prefix_rule(pattern=["md5"], decision="allow", justification="MD5 checksum")
prefix_rule(pattern=["shasum"], decision="allow", justification="SHA checksum")

# --- Directory operations ---
prefix_rule(pattern=["mkdir"], decision="allow", justification="Create directory")
prefix_rule(pattern=["cd"], decision="allow", justification="Change directory")
prefix_rule(pattern=["touch"], decision="allow", justification="Create/update file")
prefix_rule(pattern=["cp"], decision="allow", justification="Copy files")
prefix_rule(pattern=["mv"], decision="allow", justification="Move files")

# -----------------------------------------------------------------------------
# PROMPT: Potentially destructive commands (require confirmation)
# -----------------------------------------------------------------------------

prefix_rule(pattern=["git", "checkout"], decision="prompt", justification="May rewrite working tree or index")
prefix_rule(pattern=["git", "push"], decision="prompt", justification="Updates remote state")
prefix_rule(pattern=["git", "merge"], decision="prompt", justification="Changes history state")
prefix_rule(pattern=["git", "rebase"], decision="prompt", justification="Rewrites history state")
prefix_rule(pattern=["git", "branch", ["-d", "-D", "--delete", "-m", "-M", "--move", "-c", "-C", "--copy"]], decision="prompt", justification="Changes branch refs")
prefix_rule(pattern=["git", "tag", ["-d", "--delete"]], decision="prompt", justification="Deletes tags")
prefix_rule(pattern=["git", "stash", ["clear", "drop", "pop", "apply", "push"]], decision="prompt", justification="Changes the working tree or stash entries")
prefix_rule(pattern=["git", "remote", ["add", "remove", "rename", "set-url", "update", "prune"]], decision="prompt", justification="Changes remote configuration or refs")
prefix_rule(pattern=["npm", "install"], decision="prompt", justification="Downloads packages and may run install scripts")
prefix_rule(pattern=["yarn"], decision="prompt", justification="Package manager commands require confirmation")
prefix_rule(pattern=["pnpm"], decision="prompt", justification="Package manager commands require confirmation")
prefix_rule(pattern=["bun"], decision="prompt", justification="Package manager commands require confirmation")
prefix_rule(pattern=["curl"], decision="prompt", justification="Network access requires confirmation")
prefix_rule(pattern=["gh", "api"], decision="prompt", justification="GitHub API may perform mutations depending on method and endpoint")
prefix_rule(pattern=["gh", "api", "--method", "POST"], decision="prompt", justification="Mutating GitHub API call")  # -f みたいなパターンはカバーできないので不完全
prefix_rule(pattern=["gh", "api", "--method", "PATCH"], decision="prompt", justification="Mutating GitHub API call")
prefix_rule(pattern=["gh", "api", "--method", "PUT"], decision="prompt", justification="Mutating GitHub API call")
prefix_rule(pattern=["gh", "api", "--method", "DELETE"], decision="prompt", justification="Mutating GitHub API call")
prefix_rule(pattern=["gh", "api", "graphql"], decision="prompt", justification="GraphQL uses POST")
prefix_rule(pattern=["git", "config"], decision="prompt", justification="git config may update repository or user configuration")
prefix_rule(pattern=["git", "reset"], decision="prompt", justification="May rewrite the index or working tree")
prefix_rule(pattern=["gh", "auth", "status"], decision="prompt", justification="Token-display flags must remain visible for approval")
prefix_rule(pattern=["env"], decision="prompt", justification="Can execute an arbitrary command with a modified environment")
prefix_rule(pattern=["fd"], decision="prompt", justification="Can execute arbitrary commands through --exec")
prefix_rule(pattern=["awk"], decision="prompt", justification="Can execute arbitrary commands through system()")
prefix_rule(pattern=["xargs"], decision="prompt", justification="Executes commands assembled from input")
prefix_rule(pattern=["sed"], decision="prompt", justification="Can modify files in place or write files from scripts")
prefix_rule(pattern=["terraform", "init"], decision="prompt", justification="Downloads providers and configures backend")
prefix_rule(pattern=["terraform", "plan"], decision="prompt", justification="May refresh remote state and access provider APIs")
prefix_rule(pattern=["bq", "query"], decision="prompt", justification="BigQuery queries should require confirmation")
prefix_rule(pattern=["gcloud", "storage", "cat"], decision="prompt", justification="May read sensitive object contents")
prefix_rule(pattern=["gcloud", "secrets", "list"], decision="prompt", justification="May expose sensitive secret metadata")
prefix_rule(pattern=["gcloud", "secrets", "versions", "access"], decision="prompt", justification="Reads secret values")
prefix_rule(pattern=["tmux", "send-keys", "-t"], decision="prompt", justification="Injects input into an existing terminal session")
prefix_rule(pattern=["rm"], decision="prompt", justification="Remove files - confirm before execution")
prefix_rule(pattern=["rmdir"], decision="prompt", justification="Remove directory - confirm before execution")
prefix_rule(pattern=["chown"], decision="prompt", justification="Change ownership requires confirmation")

# -----------------------------------------------------------------------------
# FORBIDDEN: Dangerous commands
# -----------------------------------------------------------------------------

prefix_rule(pattern=["git", "push", "--force"], decision="forbidden", justification="Force push is forbidden")
prefix_rule(pattern=["git", "push", "-f"], decision="forbidden", justification="Force push is forbidden")
prefix_rule(pattern=["gh", "auth", "token"], decision="forbidden", justification="Do not print GitHub access tokens; use authenticated gh commands directly")
prefix_rule(
    pattern=["gh", "auth", "status", "--show-token"],
    decision="forbidden",
    justification="Do not print GitHub access tokens; omit --show-token",
    match=["gh auth status --show-token", "gh auth status --show-token --hostname github.com"],
    not_match=["gh auth status", "gh auth status --hostname github.com --show-token"],
)
prefix_rule(
    pattern=["gh", "auth", "status", "-t"],
    decision="forbidden",
    justification="Do not print GitHub access tokens; omit -t",
    match=["gh auth status -t", "gh auth status -t --hostname github.com"],
    not_match=["gh auth status", "gh auth status --hostname github.com -t"],
)
prefix_rule(pattern=["gcloud", "auth", "print-access-token"], decision="forbidden", justification="Do not print Google Cloud access tokens; use authenticated gcloud commands directly")
prefix_rule(
    pattern=["git", "reset", "--hard"],
    decision="forbidden",
    justification="Hard reset is forbidden",
    match=["git reset --hard", "git reset --hard HEAD"],
    not_match=["git reset HEAD --hard", "git reset --soft HEAD"],
)
prefix_rule(
    pattern=["git", "reset", "HEAD", "--hard"],
    decision="forbidden",
    justification="Hard reset is forbidden",
    match=["git reset HEAD --hard"],
    not_match=["git reset HEAD", "git reset --hard HEAD"],
)
prefix_rule(pattern=["terraform", "apply"], decision="forbidden", justification="Terraform apply is forbidden")
prefix_rule(pattern=["terraform", "destroy"], decision="forbidden", justification="Terraform destroy is forbidden")
prefix_rule(pattern=["sudo"], decision="forbidden", justification="Privilege escalation is forbidden")
prefix_rule(pattern=["su"], decision="forbidden", justification="User switching is forbidden")
prefix_rule(pattern=["chmod", "777"], decision="forbidden", justification="World-writable permissions forbidden")

# --- tmux helpers ---
prefix_rule(pattern=["tmux", "list-panes", "-a", "-F", "#{session_name}:#{window_index}.#{pane_index} #{window_name} #{pane_title}"], decision="allow")
prefix_rule(pattern=["tmux", "list-sessions"], decision="allow")
