# =============================================================================
# Codex Execpolicy Rules
# このrulesは、コマンドをsandbox外で実行する必要がある場合だけ参照される。
# sandbox内で既に許可されているコマンドには適用されない。
# allowは、sandbox外での実行を確認なしで許可する。
# sandbox内でも常に禁止する操作にはPreToolUse hookを使う。
# =============================================================================

# -----------------------------------------------------------------------------
# ALLOW: Fixed read-only network operations and dedicated wrappers
# -----------------------------------------------------------------------------

# --- GitHub CLI (read operations) ---
prefix_rule(pattern=["gh", "pr", "view"], decision="allow", justification="View PR")
prefix_rule(pattern=["gh", "pr", "list"], decision="allow", justification="List PRs")
prefix_rule(pattern=["gh", "pr", "checks"], decision="allow", justification="PR checks")
prefix_rule(pattern=["gh", "pr", "diff"], decision="allow", justification="PR diff")
prefix_rule(pattern=["gh", "pr", "status"], decision="allow", justification="PR status")
prefix_rule(pattern=["gh", "issue", "view"], decision="allow", justification="View issue")
prefix_rule(pattern=["gh", "issue", "list"], decision="allow", justification="List issues")
prefix_rule(pattern=["gh", "issue", "status"], decision="allow", justification="Issue status")
prefix_rule(pattern=["gh", "repo", "view"], decision="allow", justification="View repo")
prefix_rule(pattern=["gh", "run", "list"], decision="allow", justification="List workflow runs")
prefix_rule(pattern=["gh", "run", "view"], decision="allow", justification="View workflow run")
prefix_rule(pattern=["gh", "run", "watch"], decision="allow", justification="Watch workflow run")
prefix_rule(pattern=["gh", "workflow", "list"], decision="allow", justification="List workflows")
prefix_rule(pattern=["gh", "workflow", "view"], decision="allow", justification="View workflow")
prefix_rule(pattern=["gh", "release", "list"], decision="allow", justification="List releases")
prefix_rule(pattern=["gh", "release", "view"], decision="allow", justification="View release")
prefix_rule(pattern=["gh", "search"], decision="allow", justification="Search GitHub resources")
prefix_rule(pattern=["gh-read"], decision="allow", justification="Read fixed GitHub PR and Issue data through the read-only wrapper")
prefix_rule(pattern=["gh-pr-comments"], decision="allow", justification="Read GitHub PR comments through the compatibility wrapper")

# --- gCloud CLI (read operations) ---
prefix_rule(pattern=["gcloud", "storage", "ls"], decision="allow", justification="List GCS buckets or objects")
prefix_rule(pattern=["gcloud", "run", "jobs", "list"], decision="allow", justification="List Cloud Run jobs")
prefix_rule(pattern=["gcloud", "run", "jobs", "describe"], decision="allow", justification="Describe Cloud Run job")
prefix_rule(pattern=["gcloud", "run", "jobs", "executions", "list"], decision="allow", justification="List Cloud Run job executions")
prefix_rule(pattern=["gcloud", "run", "jobs", "executions", "describe"], decision="allow", justification="Describe Cloud Run job execution")
prefix_rule(pattern=["gcloud", "run", "services", "list"], decision="allow", justification="List Cloud Run services")
prefix_rule(pattern=["gcloud", "run", "services", "describe"], decision="allow", justification="Describe Cloud Run service")
prefix_rule(pattern=["gcloud", "run", "revisions", "list"], decision="allow", justification="List Cloud Run revisions")
prefix_rule(pattern=["gcloud", "run", "revisions", "describe"], decision="allow", justification="Describe Cloud Run revision")
prefix_rule(pattern=["gcloud", "logging", "read"], decision="allow", justification="Read Cloud Logging entries")
prefix_rule(pattern=["gcloud", "auth", "list"], decision="allow", justification="List active gcloud credentials")
prefix_rule(pattern=["gcloud", "config", "list"], decision="allow", justification="List gcloud config values")
prefix_rule(pattern=["gcloud", "config", "configurations", "list"], decision="allow", justification="List gcloud configurations")

# --- BigQuery CLI (metadata reads) ---
prefix_rule(pattern=["bq", "ls"], decision="allow", justification="List BigQuery resources")
prefix_rule(pattern=["bq", "show"], decision="allow", justification="Show BigQuery resource metadata")

# --- Dedicated wrappers ---
prefix_rule(pattern=["pe"], decision="allow", justification="Run prod-errors alert triage")
prefix_rule(pattern=["codex-read-lines"], decision="allow", justification="Read an approved line range without sed execution features")
prefix_rule(pattern=["codex-force-with-lease"], decision="allow", justification="Push the current trusted branch with an explicit remote lease")

# -----------------------------------------------------------------------------
# PROMPT: Potentially destructive commands (require confirmation)
# -----------------------------------------------------------------------------

prefix_rule(pattern=["git", "checkout"], decision="prompt", justification="May rewrite working tree or index")
prefix_rule(pattern=["git", "tag", ["-d", "--delete"]], decision="prompt", justification="Deletes tags")
prefix_rule(pattern=["git", "branch", "-D"], decision="prompt", justification="Deletes a branch")
prefix_rule(pattern=["git", "branch", "-r", "-d"], decision="prompt", justification="Deletes a remote-tracking branch")
prefix_rule(pattern=["git", "diff-tree"], decision="prompt", justification="May execute configured diff helpers")
prefix_rule(pattern=["git", "cat-file"], decision="prompt", justification="May execute configured filters")
prefix_rule(pattern=["git", "stash", ["clear", "drop", "pop", "apply", "push"]], decision="prompt", justification="Changes the working tree or stash entries")
prefix_rule(pattern=["git", "remote", ["add", "remove", "rename", "set-url", "update", "prune"]], decision="prompt", justification="Changes remote configuration or refs")
prefix_rule(pattern=["npm", "install"], decision="prompt", justification="Downloads packages and may run install scripts")
prefix_rule(pattern=["yarn"], decision="prompt", justification="Package manager commands require confirmation")
prefix_rule(pattern=["pnpm"], decision="prompt", justification="Package manager commands require confirmation")
prefix_rule(pattern=["bun"], decision="prompt", justification="Package manager commands require confirmation")
prefix_rule(pattern=["curl"], decision="prompt", justification="Network access requires confirmation")
prefix_rule(pattern=["gh", "api"], decision="prompt", justification="GitHub API may perform mutations depending on method and endpoint")
prefix_rule(pattern=["gh", "pr", "checkout"], decision="prompt", justification="May reset an existing branch")
prefix_rule(pattern=["gh", "pr", ["comment", "review", "merge"]], decision="prompt", justification="Changes pull request state")
prefix_rule(pattern=["gh", "issue", "comment"], decision="prompt", justification="Posts an issue comment")
prefix_rule(pattern=["gh", "workflow", "run"], decision="prompt", justification="Starts a workflow run")
prefix_rule(pattern=["git", "config"], decision="prompt", justification="git config may update repository or user configuration")
prefix_rule(pattern=["git", "reset"], decision="prompt", justification="May rewrite the index or working tree")
prefix_rule(pattern=["git", "worktree", ["remove", "prune"]], decision="prompt", justification="Removes worktrees or worktree metadata")
prefix_rule(pattern=["git", "submodule", "update"], decision="prompt", justification="May checkout code and run configured helpers")
prefix_rule(pattern=["gh", "auth", "status"], decision="prompt", justification="Token-display flags must remain visible for approval")
prefix_rule(pattern=["env"], decision="prompt", justification="Can execute an arbitrary command with a modified environment")
prefix_rule(pattern=["fd"], decision="prompt", justification="Can execute arbitrary commands through --exec")
prefix_rule(pattern=["awk"], decision="prompt", justification="Can execute arbitrary commands through system()")
prefix_rule(pattern=["xargs"], decision="prompt", justification="Executes commands assembled from input")
prefix_rule(pattern=["sed"], decision="prompt", justification="Can modify files in place or write files from scripts")
prefix_rule(pattern=["rg"], decision="prompt", justification="Can execute an arbitrary preprocessor through --pre")
prefix_rule(pattern=["bat"], decision="prompt", justification="Can execute an arbitrary pager through --pager")
prefix_rule(pattern=["printenv"], decision="prompt", justification="May expose credentials from the environment")
prefix_rule(pattern=["ps"], decision="prompt", justification="Environment display modes may expose credentials")
prefix_rule(pattern=["tee"], decision="prompt", justification="Can overwrite files outside the workspace")
prefix_rule(pattern=[["cp", "mv"]], decision="prompt", justification="Can replace files outside the workspace or Git metadata")
prefix_rule(pattern=["terraform", "init"], decision="prompt", justification="Downloads providers and configures backend")
prefix_rule(pattern=["terraform", "plan"], decision="prompt", justification="May refresh remote state and access provider APIs")
prefix_rule(pattern=["terraform", ["show", "output"]], decision="prompt", justification="May reveal sensitive values from state")
prefix_rule(pattern=["bq", "query"], decision="prompt", justification="BigQuery queries should require confirmation")
prefix_rule(pattern=["gcloud", "storage", "cat"], decision="prompt", justification="May read sensitive object contents")
prefix_rule(pattern=["gcloud", "secrets", "list"], decision="prompt", justification="May expose sensitive secret metadata")
prefix_rule(pattern=["gcloud", "secrets", "versions", "access"], decision="prompt", justification="Reads secret values")
prefix_rule(pattern=["tmux", "send-keys", "-t"], decision="prompt", justification="Injects input into an existing terminal session")
prefix_rule(pattern=["rm"], decision="prompt", justification="Remove files - confirm before execution")
prefix_rule(pattern=["rmdir"], decision="prompt", justification="Remove directory - confirm before execution")
prefix_rule(pattern=["chown"], decision="prompt", justification="Change ownership requires confirmation")

# -----------------------------------------------------------------------------
# FORBIDDEN: Dangerous commands
# sandbox内でも止める直接形式はhooks/command policyにも回帰テストを追加する。
# rulesとhookは対象となる実行層が異なるため、完全に同一の判定表にはしない。
# -----------------------------------------------------------------------------

prefix_rule(pattern=["git", "push", "--force"], decision="forbidden", justification="Force push is forbidden")
prefix_rule(pattern=["git", "push", "--for"], decision="forbidden", justification="Force push is forbidden")
prefix_rule(pattern=["git", "push", "-f"], decision="forbidden", justification="Force push is forbidden")
prefix_rule(pattern=["git", "push", "--force-with-lease"], decision="forbidden", justification="History-rewriting push is forbidden")
prefix_rule(pattern=["git", "push", "--mirror"], decision="forbidden", justification="Mirroring all refs is forbidden")
prefix_rule(pattern=["git", "push", "--mir"], decision="forbidden", justification="Mirroring all refs is forbidden")
prefix_rule(pattern=["git", "push", "--delete"], decision="forbidden", justification="Deleting remote refs is forbidden")
prefix_rule(pattern=["git", "push", "--del"], decision="forbidden", justification="Deleting remote refs is forbidden")
prefix_rule(pattern=["git", "push", "-d"], decision="forbidden", justification="Deleting remote refs is forbidden")
prefix_rule(pattern=["git", "push", "--prune"], decision="forbidden", justification="Pruning remote refs is forbidden")
prefix_rule(pattern=["git", "push", "--pru"], decision="forbidden", justification="Pruning remote refs is forbidden")
prefix_rule(pattern=["git", "clean", "-fdx"], decision="forbidden", justification="Deleting ignored and untracked files is forbidden")
prefix_rule(pattern=["git", "clean", "--for"], decision="forbidden", justification="Deleting ignored and untracked files is forbidden")
prefix_rule(pattern=["git", "gc", "--prune=now"], decision="forbidden", justification="Immediate object pruning is forbidden")
prefix_rule(pattern=["git", "add", "-f"], decision="forbidden", justification="Force-add bypasses .gitignore; omit -f")
prefix_rule(pattern=["git", "add", "--force"], decision="forbidden", justification="Force-add bypasses .gitignore; omit --force")
prefix_rule(pattern=["git", "add", "--for"], decision="forbidden", justification="Force-add bypasses .gitignore; omit --force")
prefix_rule(pattern=["gh", "auth", "token"], decision="forbidden", justification="Do not print GitHub access tokens; use authenticated gh commands directly")
prefix_rule(pattern=["gh", "repo", "delete"], decision="forbidden", justification="Repository deletion is forbidden")
prefix_rule(
    pattern=["gh", "auth", "status", "--show-token"],
    decision="forbidden",
    justification="Do not print GitHub access tokens; omit --show-token",
    match=["gh auth status --show-token", "gh auth status --show-token --hostname github.com"],
    not_match=["gh auth status", "gh auth status --hostname github.com --show-token"],
)
prefix_rule(
    pattern=["gh", "auth", "status", "-t"],
    decision="forbidden",
    justification="Do not print GitHub access tokens; omit -t",
    match=["gh auth status -t", "gh auth status -t --hostname github.com"],
    not_match=["gh auth status", "gh auth status --hostname github.com -t"],
)
prefix_rule(pattern=["gcloud", "auth", "print-access-token"], decision="forbidden", justification="Do not print Google Cloud access tokens; use authenticated gcloud commands directly")
prefix_rule(pattern=["gcloud", "projects", "delete"], decision="forbidden", justification="Cloud project deletion is forbidden")
prefix_rule(pattern=["gcloud", "storage", "rm"], decision="forbidden", justification="Cloud Storage deletion is forbidden")
prefix_rule(pattern=["gcloud", "run", "jobs", "delete"], decision="forbidden", justification="Cloud Run job deletion is forbidden")
prefix_rule(pattern=["gcloud", "run", "services", "delete"], decision="forbidden", justification="Cloud Run service deletion is forbidden")
prefix_rule(pattern=["gcloud", "iam", "service-accounts", "keys", "create"], decision="forbidden", justification="Service account key creation is forbidden")
prefix_rule(pattern=["gh", "ssh-key", "add"], decision="forbidden", justification="Adding account SSH keys is forbidden")
prefix_rule(pattern=["gh", "gpg-key", "add"], decision="forbidden", justification="Adding account GPG keys is forbidden")
prefix_rule(pattern=["gh", "auth", ["login", "refresh", "setup-git"]], decision="forbidden", justification="Changing GitHub authentication is forbidden")
prefix_rule(
    pattern=["git", "reset", "--hard"],
    decision="forbidden",
    justification="Hard reset is forbidden",
    match=["git reset --hard", "git reset --hard HEAD"],
    not_match=["git reset HEAD --hard", "git reset --soft HEAD"],
)
prefix_rule(pattern=["git", "reset", "--har"], decision="forbidden", justification="Hard reset is forbidden")
prefix_rule(
    pattern=["git", "reset", "HEAD", "--hard"],
    decision="forbidden",
    justification="Hard reset is forbidden",
    match=["git reset HEAD --hard"],
    not_match=["git reset HEAD", "git reset --hard HEAD"],
)
prefix_rule(pattern=["terraform", "apply"], decision="forbidden", justification="Terraform apply is forbidden")
prefix_rule(pattern=["terraform", "destroy"], decision="forbidden", justification="Terraform destroy is forbidden")
prefix_rule(pattern=["terraform", "state", ["rm", "mv"]], decision="forbidden", justification="Direct Terraform state mutation is forbidden")
prefix_rule(pattern=["terraform", ["taint", "import", "force-unlock"]], decision="forbidden", justification="Direct Terraform state mutation is forbidden")
prefix_rule(pattern=["terraform", "workspace", "delete"], decision="forbidden", justification="Terraform workspace deletion is forbidden")
prefix_rule(pattern=["git", "restore", [".", ":/"]], decision="forbidden", justification="Restoring the entire working tree is forbidden")
prefix_rule(pattern=["git", "switch", "--disc"], decision="forbidden", justification="Forced branch switching is forbidden")
prefix_rule(pattern=["git", "switch", "--force-c"], decision="forbidden", justification="Forced branch switching is forbidden")
prefix_rule(pattern=["git", "switch", "--or"], decision="forbidden", justification="Orphan branch switching is forbidden")
prefix_rule(pattern=["git", "rebase", "--ex"], decision="forbidden", justification="Git rebase command execution is forbidden")
prefix_rule(pattern=["git", "checkout", "--", [".", ":/"]], decision="forbidden", justification="Discarding the entire working tree is forbidden")
prefix_rule(pattern=["git", "stash", ["clear", "drop"]], decision="forbidden", justification="Deleting stash entries is forbidden")
prefix_rule(pattern=["find", ".", "-delete"], decision="forbidden", justification="Recursive deletion through find is forbidden")
prefix_rule(pattern=["chezmoi", ["purge", "destroy"]], decision="forbidden", justification="Deleting chezmoi source or target state is forbidden")
prefix_rule(pattern=["bq", "rm"], decision="forbidden", justification="BigQuery resource deletion is forbidden")
prefix_rule(pattern=["sudo"], decision="forbidden", justification="Privilege escalation is forbidden")
prefix_rule(pattern=["su"], decision="forbidden", justification="User switching is forbidden")
prefix_rule(pattern=["chmod", "777"], decision="forbidden", justification="World-writable permissions forbidden")
