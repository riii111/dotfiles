#!/bin/zsh -f
# Runs gh with GH_CONFIG_DIR set to the account folder for the target
# repository's owner. Each folder's hosts.yml names one github.com user, so gh
# reads that user's keychain item, and concurrent calls for different accounts
# never touch shared state the way gh auth switch does.
# Other hosts are not listed in those hosts.yml files; gh falls back to that
# host's own keychain item, never to the github.com token.
# This is a PATH wrapper rather than a shell function because the Bash tools of
# Claude Code and Codex run non-interactive shells, which never reach the
# function definitions in .zshrc.

emulate -R zsh
setopt extended_glob

# Captured at top level: inside a function, $0 is the function name.
wrapper_path=${0:A}
accounts_dir=$HOME/.config/gh-accounts

_gh_real_binary() {
  local candidate
  for candidate in ${(f)"$(whence -ap gh)"}; do
    if [[ ${candidate:A} != "$wrapper_path" ]]; then
      print -r -- "$candidate"
      return 0
    fi
  done
  return 1
}

# Accepts OWNER/REPO, HOST/OWNER/REPO, URLs and scp-like git remotes.
_gh_owner_of_location() {
  local value=$1
  if [[ $value == *://* ]]; then
    value=${value#*://}
  else
    value=${value/:/\/}
  fi
  value=${value#*@}
  local -a parts=(${(s:/:)value})
  case ${#parts} in
    0 | 1) return 1 ;;
    2) print -r -- "$parts[1]" ;;
    *) print -r -- "$parts[2]" ;;
  esac
}

# Prints the account folder name, or nothing when no account is determined.
_gh_target_account() {
  local -a args=("$@")
  local i arg repo url_owner origin owner
  for ((i = 1; i <= $#args; i++)); do
    arg=$args[i]
    case $arg in
      -R | --repo) ((i++)); repo=$args[i] ;;
      --repo=*) repo=${arg#--repo=} ;;
      -R*) repo=${${arg#-R}#=} ;;
      (#i)https://(www.|)github.com/[^/[:space:]]##(/[^[:space:]]#|))
        [[ -z $url_owner ]] && url_owner=${${arg#(#i)*github.com/}%%/*}
        ;;
    esac
  done
  repo=${repo:-${GH_REPO-}}

  if [[ -n $repo ]]; then
    owner=$(_gh_owner_of_location "$repo")
  elif [[ -n $url_owner ]]; then
    owner=$url_owner
  elif origin=$(command git remote get-url origin 2>/dev/null); then
    owner=$(_gh_owner_of_location "$origin")
  elif [[ "$PWD/" == "${GHQ_ROOT:-$HOME/ghq}/github.com/"[^/]##/* ]]; then
    owner=${${PWD#${GHQ_ROOT:-$HOME/ghq}/github.com/}%%/*}
  fi

  case ${(L)owner} in
    riii111) print -r -- personal ;;
{{- if eq .type "work" }}
    {{ .gh_work_org | lower }}) print -r -- work ;;
{{- end }}
  esac
}

real_gh=$(_gh_real_binary) || {
  print -u2 "gh: no gh binary found on PATH besides this wrapper"
  exit 127
}

# An outer GH_CONFIG_DIR also covers nested calls such as git-credential run by
# gh itself, which must stay on the parent's account. Tokens in the environment
# take precedence inside gh anyway. auth subcommands manage the stored accounts.
if [[ -n ${GH_CONFIG_DIR-}${GH_TOKEN-}${GITHUB_TOKEN-} ]] || [[ $1 == auth && $2 != git-credential ]]; then
  exec "$real_gh" "$@"
fi

account=$(_gh_target_account "$@")
if [[ -n $account ]]; then
  if [[ -f $accounts_dir/$account/hosts.yml ]]; then
    export GH_CONFIG_DIR=$accounts_dir/$account
  else
    print -u2 "gh: $accounts_dir/$account/hosts.yml is missing; using the active account"
  fi
fi
exec "$real_gh" "$@"
