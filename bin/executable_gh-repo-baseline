#!/usr/bin/env python3

"""Apply the repository settings and default branch ruleset shared by my repositories."""

import json
import os
import subprocess
import sys


RULESET_NAME = "baseline"
REPOSITORY_ADMIN_ROLE_ID = 5

REPOSITORY_SETTINGS = {
    "allow_auto_merge": True,
    "delete_branch_on_merge": True,
    "has_wiki": False,
}

# Required status checks differ per repository, so they belong in a separate ruleset.
RULESET = {
    "name": RULESET_NAME,
    "target": "branch",
    "enforcement": "active",
    "conditions": {"ref_name": {"include": ["~DEFAULT_BRANCH"], "exclude": []}},
    "bypass_actors": [
        {
            "actor_id": REPOSITORY_ADMIN_ROLE_ID,
            "actor_type": "RepositoryRole",
            "bypass_mode": "always",
        }
    ],
    "rules": [{"type": "deletion"}, {"type": "non_fast_forward"}],
}


def main() -> int:
    if len(sys.argv) > 2 or (len(sys.argv) == 2 and sys.argv[1].startswith("-")):
        print("usage: gh-repo-baseline [OWNER/REPO]", file=sys.stderr)
        return 2
    try:
        repo = sys.argv[1] if len(sys.argv) == 2 else current_repository()
        # The gh wrapper picks the account from GH_REPO, not from API paths.
        os.environ["GH_REPO"] = repo
        apply(repo)
    except subprocess.CalledProcessError as error:
        print(f"gh-repo-baseline: {' '.join(error.cmd)} failed: {error.stderr.strip()}", file=sys.stderr)
        return 1
    print(f"applied baseline to {repo}")
    return 0


def apply(repo: str) -> None:
    gh_api("-X", "PATCH", f"repos/{repo}", body=REPOSITORY_SETTINGS)
    gh_api("-X", "PUT", f"repos/{repo}/vulnerability-alerts")
    gh_api("-X", "PUT", f"repos/{repo}/automated-security-fixes")

    ids = gh_api(
        "--paginate", f"repos/{repo}/rulesets", "--jq", f'.[] | select(.name == "{RULESET_NAME}") | .id'
    ).split()
    if ids:
        gh_api("-X", "PUT", f"repos/{repo}/rulesets/{ids[0]}", body=RULESET)
    else:
        gh_api("-X", "POST", f"repos/{repo}/rulesets", body=RULESET)


def current_repository() -> str:
    return run(["gh", "repo", "view", "--json", "nameWithOwner", "--jq", ".nameWithOwner"]).strip()


def gh_api(*args: str, body: dict | None = None) -> str:
    if body is None:
        return run(["gh", "api", *args])
    return run(["gh", "api", *args, "--input", "-"], stdin=json.dumps(body))


def run(command: list[str], stdin: str | None = None) -> str:
    return subprocess.run(
        command, input=stdin, capture_output=True, text=True, check=True
    ).stdout


if __name__ == "__main__":
    raise SystemExit(main())
