#!/usr/bin/env python3

"""Prepare independent review requests for existing Codex/Claude tools."""

import argparse
import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path


sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))

from dot.handoff import HandoffError as ReviewError
from dot.handoff import (
    chat_id,
    document_refs,
    read_request,
    single_line,
    skills_root,
    task_id,
)


def git(checkout, *args):
    result = subprocess.run(
        ["git", "-C", str(checkout), *args], capture_output=True, text=True
    )
    if result.returncode:
        raise ReviewError(result.stderr.strip())
    return result.stdout.strip()


def candidate(path, previous=None, update_base=False):
    data = read_request(
        path,
        (
            "taskId",
            "workerAI",
            "workerChatId",
            "projectId",
            "checkout",
            "baseBranch",
            "documentRefs",
        ),
        ("prUrl",),
    )
    task_id(data["taskId"])
    document_refs(data["documentRefs"])
    chat_id(data["workerChatId"], "workerChatId")
    for key in ("workerChatId", "projectId", "checkout", "baseBranch"):
        single_line(data[key], key)
    if data["workerAI"] not in ("Claude", "Codex"):
        raise ReviewError("workerAI must be Claude or Codex")
    if data.get("prUrl") is not None and (
        not isinstance(data["prUrl"], str)
        or not re.fullmatch(
            r"https://[^/\s]+/[^/\s]+/[^/\s]+/pull/[1-9][0-9]*/?", data["prUrl"]
        )
    ):
        raise ReviewError("prUrl must be a pull request URL or null")
    data.setdefault("prUrl", None)
    checkout = Path(data["checkout"])
    if not checkout.is_absolute() or not checkout.is_dir():
        raise ReviewError("checkout must be an existing absolute directory")
    data["checkout"] = str(checkout.resolve())
    if git(checkout, "status", "--porcelain", "--untracked-files=no"):
        raise ReviewError("checkout has uncommitted tracked changes")
    data["head"] = git(checkout, "rev-parse", "HEAD")
    if previous and not update_base:
        if previous.get("baseBranch") not in (None, data["baseBranch"]):
            raise ReviewError(
                "baseBranch changed; use --update-base after integrating upstream"
            )
        data["base"] = previous["base"]
    else:
        reference = git(
            checkout,
            "rev-parse",
            "--symbolic-full-name",
            "--verify",
            "--end-of-options",
            data["baseBranch"],
        )
        if not reference.startswith(("refs/heads/", "refs/remotes/")):
            raise ReviewError("baseBranch must name a local or remote branch")
        data["base"] = git(checkout, "rev-parse", "--verify", reference + "^{commit}")
    if git(checkout, "merge-base", data["base"], data["head"]) != data["base"]:
        raise ReviewError("review base must be an ancestor of head")
    return data


def session_value(data, key):
    old_names = {
        "taskId": "identifier",
        "workerAI": "worker",
        "workerChatId": "workerId",
    }
    value = data.get(key, data.get(old_names.get(key)))
    return (
        str(Path(value).resolve())
        if key == "checkout" and isinstance(value, str)
        else value
    )


def pending_candidate(path, saved):
    if "workerId" not in saved:
        return candidate(path, saved)
    data = json.loads(path.read_text())
    if data != saved:
        raise ReviewError("pending creation must keep the original candidate")
    checkout = Path(data["checkout"])
    if git(checkout, "rev-parse", "HEAD") != data["head"]:
        raise ReviewError("checkout HEAD differs from the pending candidate")
    if git(checkout, "status", "--porcelain", "--untracked-files=no"):
        raise ReviewError("checkout has uncommitted tracked changes")
    return data


def review_prompt(data, skills):
    skill = skills / "ai-code-review" / "SKILL.md"
    references = skills / "task-review-cycle" / "references"
    template = references / "reviewer.md"
    cycle_skill = skills / "task-review-cycle" / "SKILL.md"
    reply = references / ("reply-" + data["workerAI"].lower() + ".md")
    if not all(path.is_file() for path in (skill, cycle_skill, template, reply)):
        raise ReviewError("ai-code-review or reviewer templates are not installed")
    return template.read_text().format(
        skill_path=str(skill.resolve()),
        cycle_skill_path=str(cycle_skill.resolve()),
        reply_path=str(reply.resolve()),
        task_id=data["taskId"],
        document_refs=document_refs(data["documentRefs"]),
        worker_ai=data["workerAI"],
        worker_chat_id=data["workerChatId"],
        checkout=data["checkout"],
        pr_url=data["prUrl"] or "null",
        base=data["base"],
        head=data["head"],
    )


def save_state(path, data, *, exclusive=False):
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, delete=False) as out:
        temp = Path(out.name)
        json.dump(data, out, ensure_ascii=False)
    try:
        if exclusive:
            os.link(temp, path)
        else:
            os.replace(temp, path)
    finally:
        temp.unlink(missing_ok=True)


def load_state(path):
    if not path.exists():
        return None
    state = json.loads(path.read_text())
    if (
        not isinstance(state, dict)
        or not isinstance(state.get("candidate"), dict)
        or (
            state.get("reviewer") is not None
            if state.get("pending_create") is True
            else not isinstance(state.get("reviewer"), str) or not state["reviewer"]
        )
    ):
        raise ReviewError(
            "unsupported review state; inspect it before choosing --state"
        )
    return state


def check_session(state, data):
    if state:
        for key in ("taskId", "workerAI", "workerChatId", "projectId", "checkout"):
            if session_value(state["candidate"], key) != session_value(data, key):
                raise ReviewError(f"review session must keep the original {key}")


def state_path(explicit):
    if explicit:
        return Path(explicit).resolve()
    return (
        Path(git(Path.cwd(), "rev-parse", "--show-toplevel")) / ".reviewctl/state.json"
    )


def main(argv=None):
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.ArgumentDefaultsHelpFormatter
    )
    parser.add_argument(
        "--state", help="state file; defaults to .reviewctl/state.json in this worktree"
    )
    parser.add_argument(
        "--skills-root",
        type=Path,
        default=skills_root(),
        help="installed skills directory",
    )
    commands = parser.add_subparsers(dest="command", required=True)
    prepare = commands.add_parser(
        "prepare",
        help="reserve an initial creation and print tool arguments; never send",
    )
    prepare.add_argument("--request", type=Path, required=True)
    prepare.add_argument("--model")
    prepare.add_argument("--thinking")
    prepare.add_argument(
        "--update-base",
        action="store_true",
        help="allow a base already integrated into head",
    )
    record = commands.add_parser(
        "record", help="save a confirmed reviewer and submitted candidate"
    )
    record.add_argument("--request", type=Path, required=True)
    record.add_argument("--reviewer-thread-id", required=True)
    record.add_argument(
        "--update-base", action="store_true", help="record an explicitly updated base"
    )
    commands.add_parser("state", help="show the last recorded reviewer and candidate")
    reset = commands.add_parser(
        "reset-pending", help="release an initial creation confirmed not sent"
    )
    reset.add_argument("--not-sent", action="store_true", required=True)
    args = parser.parse_args(argv)
    try:
        path = state_path(args.state)
        state = load_state(path)
        if args.command != "state" and not args.state:
            path.parent.mkdir(parents=True, exist_ok=True)
            (path.parent / ".gitignore").write_text("*\n")
        if args.command == "state":
            if state is None:
                raise ReviewError("no confirmed reviewer has been recorded")
            output = state
        elif args.command == "reset-pending":
            if state is None or state.get("pending_create") is not True:
                raise ReviewError("no pending creation to release")
            path.unlink()
            output = {"released": "pending_create"}
        else:
            pending = state is not None and state.get("pending_create") is True
            if args.command == "prepare" and pending:
                raise ReviewError(
                    "reviewer creation is pending; inspect the original call and "
                    "record its confirmed threadId; do not create another. "
                    "Use reset-pending --not-sent only when the original "
                    "create_thread call was "
                    "confirmed not sent"
                )
            if args.command == "record" and pending:
                data = pending_candidate(args.request, state["candidate"])
            else:
                data = candidate(
                    args.request,
                    state["candidate"] if state else None,
                    args.update_base,
                )
            check_session(state, data)
            if args.command == "record":
                reviewer = chat_id(args.reviewer_thread_id, "reviewerThreadId")
                if reviewer == chat_id(
                    session_value(data, "workerChatId"), "workerChatId"
                ):
                    raise ReviewError("a worker cannot review itself")
                if pending and state["candidate"] != data:
                    raise ReviewError(
                        "pending creation must keep the original candidate"
                    )
                if (
                    state
                    and state.get("prepared") is not None
                    and state["prepared"] != data
                ):
                    raise ReviewError("prepared candidate changed before record")
                if state and not pending and state["reviewer"] != reviewer:
                    raise ReviewError("review session must keep the same reviewer")
                output = {"reviewer": reviewer, "candidate": data}
                save_state(path, output)
            else:
                arguments = {"prompt": review_prompt(data, args.skills_root)}
                if state:
                    tool = "send_message_to_thread"
                    arguments["threadId"] = state["reviewer"]
                    for key in ("model", "thinking"):
                        if getattr(args, key) is not None:
                            arguments[key] = getattr(args, key)
                else:
                    tool = "create_thread"
                    arguments.update(
                        target={
                            "type": "project",
                            "projectId": data["projectId"],
                            "environment": {"type": "worktree"},
                        },
                        title="Review " + data["taskId"],
                        model=args.model or "gpt-6.1-sol",
                        thinking=args.thinking or "medium",
                    )
                output = {"tool": tool, "arguments": arguments}
                if state is None:
                    save_state(
                        path,
                        {"reviewer": None, "pending_create": True, "candidate": data},
                        exclusive=True,
                    )
                else:
                    save_state(path, {**state, "prepared": data})
        print(json.dumps(output, ensure_ascii=False))
        return 0
    except (ReviewError, OSError, ValueError) as error:
        print(f"reviewctl: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
