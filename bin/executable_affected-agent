#!/usr/bin/env python3

import os
import subprocess
import sys
from pathlib import Path


def main(argv: list[str]) -> int:
    if argv != ["after-apply"]:
        return 2
    home = Path.home()
    agent = home / ".local/bin/am-i-affected"
    if not os.access(agent, os.X_OK):
        return 0
    env = os.environ.copy()
    # GUI hooks do not guarantee the managed tool paths.
    env["PATH"] = (
        f"{home}/.nix-profile/bin:{home}/.local/bin:"
        "/run/current-system/sw/bin:/opt/homebrew/bin:"
        f"{env.get('PATH', os.defpath)}"
    )
    try:
        subprocess.run(
            [str(agent), "after-apply"],
            env=env,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=2,
            check=False,
        )
    except (subprocess.TimeoutExpired, OSError):
        pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
