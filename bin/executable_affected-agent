#!/usr/bin/env python3

import json
import os
import subprocess
import sys
import time
from pathlib import Path


UNAVAILABLE = "AIA: status unavailable | Mac: unknown | cloud: unknown"


def main(argv: list[str]) -> int:
    if len(argv) != 1 or argv[0] not in ("status", "codex-status", "after-apply"):
        return 2
    command = "status" if argv[0] == "codex-status" else argv[0]
    home = Path.home()
    agent = home / ".local/bin/am-i-affected"
    if not os.access(agent, os.X_OK):
        return 0
    env = os.environ.copy()
    # GUI hooks do not guarantee the managed tool paths.
    env["PATH"] = (
        f"{home}/.nix-profile/bin:{home}/.local/bin:"
        "/run/current-system/sw/bin:/opt/homebrew/bin:"
        f"{env.get('PATH', os.defpath)}"
    )
    try:
        if command == "status":
            env["AM_I_AFFECTED_STATUS_DEADLINE"] = str(time.monotonic() + 0.35)
        result = subprocess.run(
            [str(agent), command],
            env=env,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE if command == "status" else subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=2 if command == "after-apply" else 0.5,
            check=False,
        )
    except subprocess.TimeoutExpired as error:
        code, output = 1, error.output or b""
    except OSError:
        code, output = 1, b""
    else:
        code, output = result.returncode, result.stdout or b""
    clean = "".join(
        c
        for c in output.decode("utf-8", errors="replace")
        if c.isprintable() or c == "\n"
    )
    lines = [" ".join(line.split()) for line in clean.split("\n")]
    text = next((line for line in reversed(lines) if line), "")[:512]
    if command == "status":
        if code and not text:
            text = UNAVAILABLE
        if text:
            print(
                json.dumps({"systemMessage": text})
                if argv[0] == "codex-status"
                else text
            )
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
