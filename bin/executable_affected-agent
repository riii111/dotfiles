#!/usr/bin/env python3

import json
import os
import subprocess
import sys
from pathlib import Path


UNAVAILABLE = "AIA: status unavailable | Mac: unknown | cloud: unknown"


def main(argv: list[str]) -> int:
    if len(argv) != 1 or argv[0] not in ("status", "codex-status", "after-apply"):
        return 2
    command = "status" if argv[0] == "codex-status" else argv[0]
    agent = Path(
        os.environ.get(
            "AM_I_AFFECTED_BIN", str(Path.home() / ".local/bin/am-i-affected")
        )
    ).expanduser()
    if not agent.is_absolute() or not os.access(agent, os.X_OK):
        return 0
    env = os.environ.copy()
    env["PATH"] = os.pathsep.join(
        [
            str(Path.home() / ".nix-profile/bin"),
            str(Path.home() / ".local/bin"),
            "/run/current-system/sw/bin",
            "/opt/homebrew/bin",
            env.get("PATH", os.defpath),
        ]
    )
    try:
        result = subprocess.run(
            [str(agent), command],
            cwd=Path.home(),
            env=env,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE if command == "status" else subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=2 if command == "after-apply" else 0.5,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        code, text = 1, ""
    else:
        code = result.returncode
        text = (result.stdout or b"").decode("utf-8", errors="replace")
        text = " ".join(
            "".join(c for c in text if c.isprintable() or c == "\n").split()
        )[:512]
    if command == "status":
        if code:
            text = UNAVAILABLE
        if text:
            print(
                json.dumps({"systemMessage": text})
                if argv[0] == "codex-status"
                else text
            )
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
