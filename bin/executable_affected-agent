#!/usr/bin/env python3

import json
import os
import subprocess
import sys
from pathlib import Path


TIMEOUTS = {"status": 0.5, "after-apply": 2}
UNAVAILABLE = "AIA: status unavailable | Mac: unknown | cloud: unknown"


def invoke(command: str) -> tuple[int, str]:
    agent = Path(
        os.environ.get(
            "AM_I_AFFECTED_BIN", str(Path.home() / ".local/bin/am-i-affected")
        )
    ).expanduser()
    if not agent.is_absolute() or not os.access(agent, os.X_OK):
        return 0, ""
    env = os.environ.copy()
    env["PATH"] = os.pathsep.join(
        [
            str(Path.home() / ".nix-profile/bin"),
            str(Path.home() / ".local/bin"),
            "/run/current-system/sw/bin",
            "/opt/homebrew/bin",
            env.get("PATH", os.defpath),
        ]
    )
    if command in ("collect-and-push", "watch-wake"):
        try:
            if command == "collect-and-push":
                os.chdir(Path.home())
                devnull = os.open(os.devnull, os.O_RDWR)
                try:
                    for descriptor in (0, 1, 2):
                        os.dup2(devnull, descriptor)
                finally:
                    if devnull > 2:
                        os.close(devnull)
            os.execve(str(agent), [str(agent), command], env)
        except OSError:
            return 1, ""
    try:
        result = subprocess.run(
            [str(agent), command],
            cwd=Path.home(),
            env=env,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE if command == "status" else subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=TIMEOUTS[command],
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return 1, ""
    text = (result.stdout or b"").decode("utf-8", errors="replace")
    text = " ".join("".join(c for c in text if c.isprintable() or c == "\n").split())
    return result.returncode, text[:512]


def main(argv: list[str]) -> int:
    if len(argv) != 1 or argv[0] not in {
        *TIMEOUTS,
        "codex-status",
        "watch-wake",
        "collect-and-push",
    }:
        return 2
    command = "status" if argv[0] == "codex-status" else argv[0]
    code, text = invoke(command)
    if command == "status":
        if code:
            text = UNAVAILABLE
        if text:
            print(
                json.dumps({"systemMessage": text})
                if argv[0] == "codex-status"
                else text
            )
    return code if command in ("collect-and-push", "watch-wake") else 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
