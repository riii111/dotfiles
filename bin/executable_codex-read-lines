#!/usr/bin/env python3

"""Read an inclusive line range from a trusted repository or Codex skill."""

import sys
from pathlib import Path


sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))

from dot import git_trust


MAX_LINE = 1_000_000


def worktree_root(cwd: Path) -> Path | None:
    result = git_trust.run_git(cwd, "rev-parse", "--show-toplevel")
    if result.returncode != 0:
        return None
    return Path(result.stdout.strip()).resolve()


def skill_root() -> Path:
    return (Path.home() / ".codex" / "skills").resolve()


def plugin_skill_roots() -> list[Path]:
    cache = (Path.home() / ".codex" / "plugins" / "cache").resolve()
    roots = []
    try:
        providers = list(cache.iterdir())
    except OSError:
        return roots
    for provider in providers:
        if provider.is_symlink() or not provider.is_dir():
            continue
        try:
            plugins = list(provider.iterdir())
        except OSError:
            continue
        for plugin in plugins:
            if plugin.is_symlink() or not plugin.is_dir():
                continue
            try:
                versions = list(plugin.iterdir())
            except OSError:
                continue
            for version in versions:
                skills = version / "skills"
                if version.is_symlink() or not version.is_dir() or not skills.is_dir():
                    continue
                try:
                    resolved = skills.resolve(strict=True)
                    resolved.relative_to(cache)
                except (OSError, ValueError):
                    continue
                roots.append(resolved)
    return roots


def allowed_file(raw_path: str, cwd: Path) -> Path | None:
    candidate = Path(raw_path)
    if not candidate.is_absolute():
        candidate = cwd / candidate
    try:
        resolved = candidate.resolve(strict=True)
    except OSError:
        return None
    if not resolved.is_file():
        return None
    roots = [skill_root(), *plugin_skill_roots()]
    repository = git_trust.trusted_repository(cwd)
    if repository is not None:
        roots.append(repository.resolve())
        current_worktree = worktree_root(cwd)
        if current_worktree is not None:
            roots.append(current_worktree)
    for root in roots:
        try:
            resolved.relative_to(root)
            return resolved
        except ValueError:
            continue
    return None


def main() -> int:
    if len(sys.argv) != 4:
        print("usage: codex-read-lines START END FILE", file=sys.stderr)
        return 2
    if not all(value.isascii() and value.isdecimal() for value in sys.argv[1:3]):
        print("line numbers must be positive decimal integers", file=sys.stderr)
        return 2
    start, end = (int(value) for value in sys.argv[1:3])
    if start < 1 or end < start or end > MAX_LINE:
        print("invalid line range", file=sys.stderr)
        return 2
    path = allowed_file(sys.argv[3], Path.cwd().resolve())
    if path is None:
        print("file is outside an approved root", file=sys.stderr)
        return 1
    try:
        with path.open(encoding="utf-8") as handle:
            for number, line in enumerate(handle, start=1):
                if number > end:
                    break
                if number >= start:
                    sys.stdout.write(line)
    except (OSError, UnicodeError) as error:
        print(f"cannot read file: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
