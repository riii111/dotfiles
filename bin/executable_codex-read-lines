#!/usr/bin/env python3

"""Read an inclusive line range from a trusted repository or Codex skill."""

import os
import subprocess
import sys
from pathlib import Path
from urllib.parse import urlparse


MAX_LINE = 1_000_000


def git_environment() -> dict[str, str]:
    environment = dict(os.environ)
    for name in list(environment):
        if name.startswith("GIT_"):
            del environment[name]
    return environment


def run_git(cwd: Path, *args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", *args],
        cwd=cwd,
        env=git_environment(),
        check=False,
        capture_output=True,
        text=True,
    )


def repository_root(cwd: Path) -> Path | None:
    result = run_git(cwd, "rev-parse", "--path-format=absolute", "--git-common-dir")
    if result.returncode != 0:
        return None
    common_dir = Path(result.stdout.strip()).resolve()
    if common_dir.name != ".git":
        return None
    root = common_dir.parent
    trusted_root = (Path.home() / "ghq" / "github.com").resolve()
    try:
        relative = root.relative_to(trusted_root)
    except ValueError:
        return None
    if len(relative.parts) != 2:
        return None
    return root


def worktree_root(cwd: Path) -> Path | None:
    result = run_git(cwd, "rev-parse", "--show-toplevel")
    if result.returncode != 0:
        return None
    return Path(result.stdout.strip()).resolve()


def github_host(host: str | None) -> bool:
    if not host:
        return False
    result = subprocess.run(
        ["ssh", "-G", host],
        env=git_environment(),
        check=False,
        capture_output=True,
        text=True,
        timeout=2,
    )
    return result.returncode == 0 and any(
        line == "hostname github.com" for line in result.stdout.splitlines()
    )


def github_repository(url: str) -> tuple[str, str] | None:
    if url.startswith("git@") and ":" in url:
        user_host, path = url[4:].split(":", 1)
        if user_host == "github.com" or github_host(user_host):
            parts = path.removesuffix(".git").split("/")
            if len(parts) == 2 and all(parts):
                return parts[0].lower(), parts[1].lower()
        return None
    parsed = urlparse(url)
    if parsed.scheme not in {"https", "ssh"} or not github_host(parsed.hostname):
        return None
    parts = parsed.path.removeprefix("/").removesuffix(".git").split("/")
    if len(parts) != 2 or not all(parts) or parsed.query or parsed.fragment:
        return None
    return parts[0].lower(), parts[1].lower()


def trusted_repository(cwd: Path) -> Path | None:
    root = repository_root(cwd)
    if root is None:
        return None
    expected = tuple(root.relative_to((Path.home() / "ghq" / "github.com").resolve()).parts)
    if len(expected) != 2:
        return None
    for push in (False, True):
        args = ["config", "--get-all"]
        args.append("remote.origin.pushurl" if push else "remote.origin.url")
        result = run_git(cwd, *args)
        if result.returncode != 0 and push:
            result = run_git(cwd, "config", "--get-all", "remote.origin.url")
        if result.returncode != 0:
            return None
        urls = [line for line in result.stdout.splitlines() if line]
        if not urls or any(github_repository(url) != expected for url in urls):
            return None
    return root


def skill_root() -> Path:
    return (Path.home() / ".codex" / "skills").resolve()


def allowed_file(raw_path: str, cwd: Path) -> Path | None:
    candidate = Path(raw_path)
    if not candidate.is_absolute():
        candidate = cwd / candidate
    try:
        resolved = candidate.resolve(strict=True)
    except OSError:
        return None
    if not resolved.is_file():
        return None
    roots = [skill_root()]
    repository = trusted_repository(cwd)
    if repository is not None:
        roots.append(repository.resolve())
        current_worktree = worktree_root(cwd)
        if current_worktree is not None:
            roots.append(current_worktree)
    for root in roots:
        try:
            resolved.relative_to(root)
            return resolved
        except ValueError:
            continue
    return None


def main() -> int:
    if len(sys.argv) != 4:
        print("usage: codex-read-lines START END FILE", file=sys.stderr)
        return 2
    if not all(value.isascii() and value.isdecimal() for value in sys.argv[1:3]):
        print("line numbers must be positive decimal integers", file=sys.stderr)
        return 2
    start, end = (int(value) for value in sys.argv[1:3])
    if start < 1 or end < start or end > MAX_LINE:
        print("invalid line range", file=sys.stderr)
        return 2
    path = allowed_file(sys.argv[3], Path.cwd().resolve())
    if path is None:
        print("file is outside an approved root", file=sys.stderr)
        return 1
    try:
        with path.open(encoding="utf-8") as handle:
            for number, line in enumerate(handle, start=1):
                if number > end:
                    break
                if number >= start:
                    sys.stdout.write(line)
    except (OSError, UnicodeError) as error:
        print(f"cannot read file: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
