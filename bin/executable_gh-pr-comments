#!/usr/bin/env python3

import os
import sys
from pathlib import Path


script_dir = Path(__file__).resolve().parent
for candidate in (script_dir / "gh-read", script_dir / "executable_gh-read"):
    if candidate.is_file():
        os.execv(sys.executable, [sys.executable, str(candidate), "pr", *sys.argv[1:]])
raise SystemExit("gh-read is not installed")
